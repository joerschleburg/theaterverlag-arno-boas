---
import { NAV } from "../lib/site";
import { path } from "../lib/paths";

interface Props {
  variant?: "hero" | "page";
  active?: string;
}

const { variant = "page", active } = Astro.props;
const home = path("/");
/** Cache-Bust: public/ Assets werden ohne Hash ausgeliefert. */
const logoVer = "20260730b";
const logoLight = `${path("/images/logo-light.png")}?v=${logoVer}`;
const logoDark = `${path("/images/logo-dark.png")}?v=${logoVer}`;
---

{
  variant === "hero" ? (
    <div class="site-mast">
      <div class="wrap">
        <div class="mast-row">
          <a class="brand" href={home}>
            <img src={logoLight} alt="Theaterverlag Arno Boas" />
          </a>
          <nav class="mast-nav" aria-label="Hauptnavigation">
            {NAV.map((item) => (
              <a href={item.href} class={active === item.match ? "active" : undefined}>
                {item.label}
              </a>
            ))}
            <a href="#merkliste" class="merk" data-merk-trigger>
              <i class="ti ti-bookmark" aria-hidden="true" /> Merkliste{" "}
              <span class="cnt" data-merk-count>0</span>
            </a>
          </nav>
          <button
            class="nav-toggle"
            type="button"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-nav-toggle
          >
            <i class="ti ti-menu-2" data-nav-icon-open aria-hidden="true" />
            <i class="ti ti-x" data-nav-icon-close aria-hidden="true" hidden />
          </button>
        </div>
        <div class="mast-line" />
      </div>
    </div>
  ) : (
    <header class="ihead">
      <div class="wrap">
        <div class="row">
          <a class="brand" href={home}>
            <img src={logoDark} alt="Theaterverlag Arno Boas" />
          </a>
          <nav class="nav" aria-label="Hauptnavigation">
            {NAV.map((item) => (
              <a href={item.href} class={active === item.match ? "active" : undefined}>
                {item.label}
              </a>
            ))}
            <a href="#merkliste" class="merk" data-merk-trigger>
              <i class="ti ti-bookmark" aria-hidden="true" /> Merkliste{" "}
              <span class="cnt" data-merk-count>0</span>
            </a>
          </nav>
          <button
            class="nav-toggle"
            type="button"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-nav-toggle
          >
            <i class="ti ti-menu-2" data-nav-icon-open aria-hidden="true" />
            <i class="ti ti-x" data-nav-icon-close aria-hidden="true" hidden />
          </button>
        </div>
      </div>
    </header>
  )
}

<div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
  <button
    type="button"
    class="mobile-nav-backdrop"
    data-nav-close
    aria-label="Menü schließen"
  ></button>
  <nav class="mobile-nav-panel" aria-label="Mobiles Menü">
    <div class="mobile-nav-top">
      <span class="mobile-nav-label">Menü</span>
      <button type="button" class="nav-toggle is-close" aria-label="Menü schließen" data-nav-close>
        <i class="ti ti-x" aria-hidden="true" />
      </button>
    </div>
    <ul class="mobile-nav-list">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class={active === item.match ? "active" : undefined}
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="#merkliste" class="merk" data-merk-trigger data-nav-link>
          <i class="ti ti-bookmark" aria-hidden="true" /> Merkliste{" "}
          <span class="cnt" data-merk-count>0</span>
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-mobile-nav]");
  const toggles = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-nav-toggle]"),
  ];
  if (root && toggles.length) {
    const closes = [
      ...root.querySelectorAll<HTMLElement>("[data-nav-close]"),
    ];
    const panel = root.querySelector<HTMLElement>(".mobile-nav-panel");
    const mq = window.matchMedia("(max-width: 980px)");
    let lastFocus: HTMLElement | null = null;
    let open = false;
    let closeTimer = 0;

    function setIcons(isOpen: boolean) {
      for (const btn of toggles) {
        const openIcon = btn.querySelector<HTMLElement>("[data-nav-icon-open]");
        const closeIcon = btn.querySelector<HTMLElement>("[data-nav-icon-close]");
        if (openIcon) openIcon.hidden = isOpen;
        if (closeIcon) closeIcon.hidden = !isOpen;
        btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
        btn.setAttribute("aria-label", isOpen ? "Menü schließen" : "Menü öffnen");
      }
    }

    function openNav() {
      if (!mq.matches || open) return;
      window.clearTimeout(closeTimer);
      open = true;
      lastFocus = document.activeElement as HTMLElement | null;
      root.hidden = false;
      document.body.classList.add("nav-open");
      setIcons(true);
      window.requestAnimationFrame(() => {
        root.classList.add("is-open");
        const first = panel?.querySelector<HTMLElement>("[data-nav-close].is-close, a");
        first?.focus();
      });
    }

    function closeNav() {
      if (!open) return;
      open = false;
      root.classList.remove("is-open");
      document.body.classList.remove("nav-open");
      setIcons(false);
      closeTimer = window.setTimeout(() => {
        root.hidden = true;
        lastFocus?.focus?.();
        lastFocus = null;
      }, 260);
    }

    function toggleNav() {
      if (open) closeNav();
      else openNav();
    }

    for (const btn of toggles) {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        toggleNav();
      });
    }
    for (const el of closes) {
      el.addEventListener("click", () => closeNav());
    }
    root.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => closeNav());
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !root.hidden) {
        e.preventDefault();
        closeNav();
      }
    });
    mq.addEventListener("change", () => {
      if (!mq.matches) closeNav();
    });
  }
</script>

<style is:global>
  body.nav-open {
    overflow: hidden;
  }
</style>

<style>
  /* Hero mast */
  .site-mast {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
  }
  .mast-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0 16px;
    gap: 16px;
  }
  .mast-row .brand img {
    height: 52px;
    width: auto;
    max-width: min(280px, 42vw);
    display: block;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.5));
  }
  .mast-nav {
    display: flex;
    gap: 34px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #f2e9d8;
  }
  .mast-nav a {
    text-decoration: none;
    opacity: 0.9;
  }
  .mast-nav a:hover,
  .mast-nav a.active {
    color: var(--gold);
    opacity: 1;
  }
  .mast-nav .merk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 1;
    padding-left: 6px;
    border-left: 1px solid rgba(255, 255, 255, 0.28);
  }
  .mast-nav .merk i {
    font-size: 17px;
  }
  .mast-nav .merk .cnt {
    background: var(--yellow);
    color: #221803;
    border-radius: 100px;
    min-width: 19px;
    height: 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    padding: 0 5px;
  }
  .mast-line {
    border-top: 1px solid rgba(255, 255, 255, 0.28);
  }

  /* Page header */
  .ihead {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--border);
  }
  .ihead .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 74px;
    gap: 16px;
  }
  .ihead .brand img {
    height: 52px;
    width: auto;
    max-width: min(280px, 42vw);
    display: block;
  }
  .ihead .nav {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--text);
  }
  .ihead .nav a {
    text-decoration: none;
  }
  .ihead .nav a:hover,
  .ihead .nav a.active {
    color: var(--wine);
  }
  .ihead .merk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 18px;
    border-left: 1px solid var(--border);
  }
  .ihead .merk .cnt {
    background: var(--wine);
    color: #fff;
    border-radius: 100px;
    min-width: 19px;
    height: 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    padding: 0 5px;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--hair);
    color: inherit;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 22px;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 72;
  }
  .nav-toggle.is-close {
    display: inline-flex;
    color: var(--text);
    border-color: var(--hair);
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 70;
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    margin: 0;
    background: rgba(26, 22, 17, 0.48);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.22s ease;
  }
  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(360px, 88vw);
    background: var(--paper);
    color: var(--text);
    border-left: 1px solid var(--border);
    padding: 20px 22px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    transform: translateX(100%);
    transition: transform 0.26s ease;
  }
  .mobile-nav.is-open .mobile-nav-backdrop {
    opacity: 1;
  }
  .mobile-nav.is-open .mobile-nav-panel {
    transform: translateX(0);
  }
  .mobile-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .mobile-nav-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    padding: 16px 4px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-head);
    font-size: 22px;
    line-height: 1.2;
  }
  .mobile-nav-list a:hover,
  .mobile-nav-list a.active {
    color: var(--wine);
  }
  .mobile-nav-list .merk {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-top: 8px;
    border-bottom: 0;
  }
  .mobile-nav-list .merk .cnt {
    background: var(--wine);
    color: #fff;
    border-radius: 100px;
    min-width: 19px;
    height: 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    padding: 0 5px;
  }

  @media (max-width: 980px) {
    .mast-nav,
    .ihead .nav {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .site-mast .nav-toggle {
      color: #f2e9d8;
      border-color: rgba(255, 255, 255, 0.35);
    }
  }
</style>
