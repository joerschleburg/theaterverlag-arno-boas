---
/** Newsletter-UI — Anbindung folgt später; Formular bewusst deaktiviert. */
---

<section class="news" aria-labelledby="nl-title">
  <div class="news-inner">
    <div class="nl-ic"><i class="ti ti-mail" aria-hidden="true"></i></div>
    <span class="cap-label">Newsletter</span>
    <h2 id="nl-title">Bleiben wir in Kontakt</h2>
    <p>
      Neue Stücke und Aktuelles aus dem Verlag – ein paar Mal im Jahr, herzlich
      und ganz ohne Werbeflut.
    </p>
    <form onsubmit="return false;">
      <input
        type="email"
        placeholder="Ihre E-Mail-Adresse"
        aria-label="E-Mail-Adresse"
        disabled
      />
      <button type="button" disabled>Anmelden</button>
    </form>
    <div class="nl-note">Kein Spam. Jederzeit abbestellbar.</div>
  </div>
</section>

<style>
  .news {
    background: transparent;
    padding: 48px 24px 18px;
  }
  .news-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(165deg, #fbeeda 0%, #f3e5ce 100%);
    border: 1px solid #e7d9be;
    border-radius: 22px;
    padding: 54px 44px;
    box-shadow: 0 18px 42px rgba(20, 12, 6, 0.08);
  }
  .nl-ic {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--wine);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
    margin-bottom: 16px;
    box-shadow: 0 8px 20px rgba(207, 85, 26, 0.3);
  }
  .news :global(.cap-label) {
    color: var(--wine);
  }
  .news h2 {
    color: var(--ink);
    font-size: clamp(28px, 4vw, 46px);
    margin-top: 12px;
    line-height: 1;
  }
  .news p {
    color: var(--text);
    margin: 14px auto 26px;
    font-size: 16.5px;
    max-width: 46ch;
  }
  .news form {
    display: flex;
    max-width: 470px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px;
    box-shadow: 0 6px 18px rgba(20, 12, 6, 0.07);
  }
  .news input {
    flex: 1;
    min-width: 150px;
    padding: 13px 20px;
    border: none;
    font-family: var(--font-body);
    font-size: 15px;
    background: transparent;
    color: var(--ink);
    outline: none;
  }
  .news input:disabled,
  .news button:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }
  .news button {
    background: var(--wine);
    color: #fff;
    border: none;
    border-radius: 100px;
    padding: 13px 28px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .nl-note {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 14px;
  }
  @media (max-width: 560px) {
    .news-inner {
      padding: 40px 22px;
    }
    .news form {
      flex-direction: column;
      border-radius: 18px;
    }
    .news button {
      width: 100%;
    }
  }
</style>
