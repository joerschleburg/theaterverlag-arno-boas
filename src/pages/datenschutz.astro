---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
---

<BaseLayout
  title="Datenschutz"
  description="Datenschutzerklärung — Theaterverlag Arno Boas."
>
  <SiteHeader />
  <section class="wrap page">
    <h1>Datenschutz</h1>
    <p>Rechtstext folgt von Arno Boas.</p>
  </section>
  <NewsletterSignup />
  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .page {
    padding-block: 56px 90px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin-bottom: 16px;
  }
  p {
    color: var(--muted);
  }
</style>
