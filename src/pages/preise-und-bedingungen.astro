---
import { path } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const faqs = [
  {
    question: "Was kostet die Aufführung eines Theaterstücks?",
    answer:
      "Bei abendfüllenden Stücken beträgt die Aufführungsgebühr 10 % der Eintrittseinnahmen, mindestens jedoch 50 € je Aufführung (zzgl. 7 % MwSt). Wählen Sie den kompletten Rollensatz, kommt der Heftpreis hinzu (15–18,50 € je Textheft, genauer Preis beim jeweiligen Stück).",
  },
  {
    question: "Was kostet die Aufführung eines Einakters oder Kurzstücks?",
    answer:
      "Einakter werden pauschal abgerechnet: 40 € für die erste, 28 € für jede weitere Aufführung. Kurzstücke kosten 18 €/11 € (Selbstkopie) bzw. 30 €/14 € (Komplettrollensatz), Sketche 15 €/9 € bzw. 27 €/12 €. Alle Preise verstehen sich zzgl. 7 % MwSt.",
  },
  {
    question: "Müssen wir auch ohne Eintritt Aufführungsgebühren zahlen?",
    answer:
      "Ja. Die Aufführungsgebühren werden auch bei Wohltätigkeitsveranstaltungen und Vorstellungen ohne Eintritt fällig.",
  },
  {
    question: "Wie lange kann ich eine Leseprobe unverbindlich ansehen?",
    answer:
      "Vier Wochen lang – eine Verlängerung ist jederzeit möglich. Zu den abendfüllenden Stücken gibt es zusätzlich eine kostenlose Leseprobe als PDF mit rund der Hälfte des Stücks.",
  },
  {
    question: "Brauchen wir einen Aufführungsvertrag?",
    answer:
      "Ja. Vor der ersten Aufführung wird ein Aufführungsvertrag abgeschlossen, der unter anderem Zahl und Datum der geplanten Aufführungen festhält. Aufführungen ohne Vertrag sind nicht gestattet.",
  },
  {
    question: "Was ist der Unterschied zwischen Selbstkopie und Komplettrollensatz?",
    answer:
      "Bei der Selbstkopie erhalten Sie das komplette Stück und vervielfältigen die Rollen selbst. Beim Komplettrollensatz liefern wir fertig gedruckte Hefte für alle Rollen plus ein Regie-Exemplar.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title="Preise & Bedingungen"
  description="Aufführungsgebühren, Rollensatz und Bedingungen — Theaterverlag Arno Boas."
  jsonLd={faqLd}
>
  <SiteHeader active="/preise-und-bedingungen" />

  <section class="intro">
    <div class="wrap narrow">
      <span class="cap-label">Faire Konditionen fürs Amateurtheater</span>
      <h1>Preise &amp; Bedingungen</h1>
      <p class="lead">
        Transparent und unkompliziert: kostenlose Leseprobe, freie Wahl zwischen
        Selbstkopie und gedrucktem Rollensatz, und faire Aufführungsgebühren. Der
        genaue Heftpreis steht bei jedem Stück.
      </p>
      <div class="stand">Stand: Juni 2024</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap narrow">
      <div class="sec-head">
        <span class="cap-label">In fünf Schritten</span>
        <h2>So kommen Sie zur Aufführung</h2>
        <p class="journey-lead">
          Tippen Sie die Stationen ab — wie eine kleine Probenliste bis zur Premiere.
        </p>
      </div>

      <div class="journey" data-journey>
        <div class="journey-progress" aria-live="polite">
          <div class="jp-track" aria-hidden="true">
            <div class="jp-fill" data-journey-fill></div>
          </div>
          <span data-journey-label>1 von 5 Stationen</span>
        </div>

        <ol class="steps">
          <li class="step is-done" data-step="1">
            <button type="button" class="step-btn" data-step-toggle aria-pressed="true">
              <span class="n" aria-hidden="true">
                <i class="ti ti-search step-ic"></i>
                <span class="step-num">1</span>
                <i class="ti ti-check step-ok"></i>
              </span>
              <span class="step-body">
                <span class="step-title">Stück finden</span>
                <span class="step-text"
                  >Im Repertoire stöbern und die kostenlose Leseprobe (PDF)
                  laden.</span
                >
              </span>
            </button>
          </li>
          <li class="step" data-step="2">
            <button type="button" class="step-btn" data-step-toggle aria-pressed="false">
              <span class="n" aria-hidden="true">
                <i class="ti ti-book step-ic"></i>
                <span class="step-num">2</span>
                <i class="ti ti-check step-ok"></i>
              </span>
              <span class="step-body">
                <span class="step-title">In Ruhe lesen</span>
                <span class="step-text"
                  >Vier Wochen unverbindlich zur Ansicht – Verlängerung
                  jederzeit.</span
                >
              </span>
            </button>
          </li>
          <li class="step" data-step="3">
            <button type="button" class="step-btn" data-step-toggle aria-pressed="false">
              <span class="n" aria-hidden="true">
                <i class="ti ti-mail step-ic"></i>
                <span class="step-num">3</span>
                <i class="ti ti-check step-ok"></i>
              </span>
              <span class="step-body">
                <span class="step-title">Anfragen</span>
                <span class="step-text"
                  >Über die Merkliste sammeln und gebündelt anfragen.</span
                >
              </span>
            </button>
          </li>
          <li class="step" data-step="4">
            <button type="button" class="step-btn" data-step-toggle aria-pressed="false">
              <span class="n" aria-hidden="true">
                <i class="ti ti-file-text step-ic"></i>
                <span class="step-num">4</span>
                <i class="ti ti-check step-ok"></i>
              </span>
              <span class="step-body">
                <span class="step-title">Vertrag</span>
                <span class="step-text"
                  >Vor der ersten Aufführung den Aufführungsvertrag
                  abschließen.</span
                >
              </span>
            </button>
          </li>
          <li class="step" data-step="5">
            <button type="button" class="step-btn" data-step-toggle aria-pressed="false">
              <span class="n" aria-hidden="true">
                <i class="ti ti-masks-theater step-ic"></i>
                <span class="step-num">5</span>
                <i class="ti ti-check step-ok"></i>
              </span>
              <span class="step-body">
                <span class="step-title">Spielen</span>
                <span class="step-text"
                  >Bühne frei – und viel Erfolg bei der Aufführung!</span
                >
              </span>
            </button>
          </li>
        </ol>

        <p class="journey-done" data-journey-done hidden>
          Premiere in Sicht — alle Stationen abgehakt. Viel Applaus!
        </p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap narrow">
      <div class="sec-head">
        <span class="cap-label">So läuft's</span>
        <h2>Ihre zwei Wege zum Stück</h2>
      </div>
      <p class="sec-intro">
        Sie haben grundsätzlich die Wahl, den kompletten Rollensatz zu bestellen
        oder sich die Texthefte selbst zu kopieren – die Entscheidung liegt bei
        Ihnen. Unabhängig davon wird vor der ersten Aufführung ein
        Aufführungsvertrag geschlossen, der Zahl und Datum der geplanten
        Aufführungen festhält.
      </p>
      <div class="ways">
        <div class="way">
          <i class="ti ti-copy" aria-hidden="true"></i>
          <h3>Texthefte selbst kopieren</h3>
          <p>Sie erhalten das komplette Stück und vervielfältigen die Rollen selbst.</p>
        </div>
        <div class="way">
          <i class="ti ti-books" aria-hidden="true"></i>
          <h3>Kompletten Rollensatz bestellen</h3>
          <p>
            Fertig gedruckte Hefte für alle Rollen plus ein Regie-Exemplar.
            Heftpreis je nach Stück (15–18,50 €).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap narrow">
      <div class="sec-head">
        <span class="cap-label">Aufführungsgebühren</span>
        <h2>Was eine Aufführung kostet</h2>
      </div>

      <div class="table-h">Alle Preise im Detail</div>
      <div class="ptable">
        <div class="prow">
          <div class="pspiel">
            <h4>Abendfüllende Stücke</h4>
            <span>ab ca. 60 Min.</span>
          </div>
          <div class="pcell">
            <span class="pl">Aufführungsgebühr (beide Varianten)</span>
            <span class="pv"
              ><b>10 %</b> der Eintrittseinnahmen,<br />mindestens <b>50 €</b> je
              Aufführung</span
            >
          </div>
          <div class="pcell">
            <span class="pl">Bei Komplettrollensatz zusätzlich</span>
            <span class="pv"
              ><b>15–18,50 €</b> je Textheft<br />(genauer Preis beim Stück)</span
            >
          </div>
        </div>
        <div class="prow">
          <div class="pspiel">
            <h4>Einakter</h4>
            <span>ca. 20–60 Min.</span>
          </div>
          <div class="pcell">
            <span class="pl">Aufführungsgebühr (pauschal)</span>
            <span class="pv"
              >1. Aufführung <b>40 €</b><br />jede weitere <b>28 €</b></span
            >
          </div>
          <div class="pcell">
            <span class="pl">Rollensatz</span>
            <span class="pv"
              >Preis nach Zahl der Hefte<br />(genauer Preis beim Stück)</span
            >
          </div>
        </div>
        <div class="prow">
          <div class="pspiel">
            <h4>Kurzstücke</h4>
            <span>ca. 10–20 Min.</span>
          </div>
          <div class="pcell">
            <span class="pl">Selbstkopie der Texthefte</span>
            <span class="pv"
              >1. Aufführung <b>18 €</b><br />jede weitere <b>11 €</b></span
            >
          </div>
          <div class="pcell">
            <span class="pl">Komplettrollensatz</span>
            <span class="pv"
              >1. Aufführung <b>30 €</b><br />jede weitere <b>14 €</b></span
            >
          </div>
        </div>
        <div class="prow">
          <div class="pspiel">
            <h4>Sketche</h4>
            <span>bis 10 Min.</span>
          </div>
          <div class="pcell">
            <span class="pl">Selbstkopie der Texthefte</span>
            <span class="pv"
              >1. Aufführung <b>15 €</b><br />jede weitere <b>9 €</b></span
            >
          </div>
          <div class="pcell">
            <span class="pl">Komplettrollensatz</span>
            <span class="pv"
              >1. Aufführung <b>27 €</b><br />jede weitere <b>12 €</b></span
            >
          </div>
        </div>
      </div>
      <p class="note">
        <b>Alle Preise zzgl. 7 % Mehrwertsteuer.</b> Bei einigen Stücken gelten
        abweichende Preise – Näheres finden Sie direkt beim jeweiligen Stück. Die
        Gebühren werden auch bei Wohltätigkeitsveranstaltungen und Vorstellungen
        ohne Eintritt fällig. Für halb- und professionelle Bühnen gelten
        gesonderte Regelungen.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap narrow">
      <div class="sec-head">
        <span class="cap-label">Verlagsbedingungen</span>
        <h2>Das Wichtigste in Kürze</h2>
      </div>
      <ol class="tlist">
        <li>
          <p>
            Sie erhalten Leseproben unverbindlich vier Wochen lang zur Ansicht.
            Eine Verlängerung ist jederzeit möglich.
          </p>
        </li>
        <li>
          <p>
            Für die Unkostenerstattung von Leseproben (Versand und Verpackung)
            gilt: pro Theaterheft 60 Cent zuzüglich Porto (wahlweise in bar, in
            Briefmarken oder per Überweisung). Auf Wunsch senden wir die
            Ansichtshefte auch per E-Mail zu. Für verloren gegangene oder
            unbrauchbar gewordene Ansichtsexemplare wird pauschal 6 € erhoben.
          </p>
        </li>
        <li>
          <p>
            Mit Bekanntgabe dieser Bedingungen verlieren alle früheren Preise und
            Bedingungen ihre Gültigkeit. Mit der Entgegennahme der Leseproben
            erkennen Sie die Bedingungen automatisch an.
          </p>
        </li>
        <li>
          <p>
            Alle Rechte hinsichtlich Verfilmung und Hörfunkausstrahlung vergibt
            ausschließlich der Verlag.
          </p>
        </li>
        <li>
          <p>
            Aufführungen sind nur nach Abschluss eines Aufführungsvertrages
            erlaubt. Unerlaubte Aufführungen sowie unerlaubtes Kopieren,
            Verleihen oder Weitergeben der Textbücher sind verboten und werden
            strafrechtlich verfolgt.
          </p>
        </li>
      </ol>
      <div class="stand">Stand: Juni 2024</div>
    </div>
  </section>

  <NewsletterSignup />

  <section class="sec">
    <div class="wrap narrow">
      <div class="sec-head faq-gap">
        <span class="cap-label">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>
                {item.question}
                <span class="ic">
                  <i class="ti ti-plus" aria-hidden="true" />
                </span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>

      <div class="cta-band">
        <div>
          <h2>Erst lesen, dann entscheiden.</h2>
          <p>
            Zu den abendfüllenden Stücken gibt es eine kostenlose Leseprobe als
            PDF – rund die Hälfte des Stücks.
          </p>
        </div>
        <div class="btns">
          <a class="prim" href={path("/kontakt")}
            ><i class="ti ti-mail" aria-hidden="true"></i> Für Aufführung
            anfragen</a
          >
          <a class="ghost" href={path("/theaterstuecke")}
            ><i class="ti ti-search" aria-hidden="true"></i> Stücke durchsuchen</a
          >
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-journey]");
  if (root) {
    const KEY = "tvab-journey-steps";
    const fill = root.querySelector<HTMLElement>("[data-journey-fill]");
    const label = root.querySelector<HTMLElement>("[data-journey-label]");
    const done = root.querySelector<HTMLElement>("[data-journey-done]");
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const total = steps.length;

    function load(): Set<string> {
      try {
        const raw = JSON.parse(localStorage.getItem(KEY) || "[]");
        const set = new Set(Array.isArray(raw) ? raw.map(String) : []);
        set.add("1");
        return set;
      } catch {
        return new Set(["1"]);
      }
    }

    function save(set: Set<string>) {
      localStorage.setItem(KEY, JSON.stringify([...set]));
    }

    function render(set: Set<string>) {
      steps.forEach((step) => {
        const id = step.dataset.step || "";
        const on = set.has(id);
        step.classList.toggle("done", on);
        const btn = step.querySelector<HTMLButtonElement>("[data-step-toggle]");
        if (btn) btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
      const n = set.size;
      if (fill) fill.style.width = `${(n / total) * 100}%`;
      if (label) {
        label.textContent =
          n === 0
            ? "0 von 5 Stationen"
            : n === total
              ? "5 von 5 — bereit für die Premiere"
              : `${n} von 5 Stationen`;
      }
      if (done) done.hidden = n !== total;
      root.dataset.progress = String(n);
    }

    let state = load();
    save(state);
    render(state);

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-step-toggle]",
      );
      if (!btn) return;
      const step = btn.closest<HTMLElement>("[data-step]");
      const id = step?.dataset.step;
      if (!id || id === "1") return;
      if (state.has(id)) state.delete(id);
      else state.add(id);
      state.add("1");
      save(state);
      render(state);
      step?.classList.add("pop");
      window.setTimeout(() => step?.classList.remove("pop"), 280);
    });
  }
</script>

<style>
  .narrow {
    max-width: 900px;
  }
  .intro {
    padding: 52px 0 0;
  }
  .intro h1 {
    font-size: clamp(38px, 6vw, 72px);
    line-height: 0.96;
    margin: 12px 0 0;
  }
  .intro .lead {
    font-size: 19px;
    margin: 18px 0 0;
    max-width: 60ch;
  }
  .stand {
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 16px;
    font-weight: 600;
  }
  .sec {
    padding: 56px 0 48px;
  }
  .sec-head {
    margin-bottom: 26px;
  }
  .sec-head h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1;
    margin-top: 10px;
  }
  .sec-intro {
    font-size: 16px;
    max-width: 70ch;
    margin: 0 0 26px;
  }
  .ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .way {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 26px;
  }
  .way i {
    font-size: 26px;
    color: var(--wine);
  }
  .way h3 {
    font-size: 22px;
    margin: 12px 0 8px;
  }
  .way p {
    font-size: 14.5px;
    color: var(--muted);
    margin: 0;
  }
  .ptable {
    border-top: 2px solid var(--ink);
    margin-top: 30px;
  }
  .prow {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1.15fr;
    gap: 26px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .pspiel h4 {
    font-size: 23px;
    line-height: 1;
  }
  .pspiel span {
    display: block;
    margin-top: 6px;
    font-size: 11.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pcell .pl {
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }
  .pcell .pv {
    font-size: 15.5px;
    line-height: 1.5;
  }
  .pcell .pv b {
    font-family: var(--font-head);
    font-weight: 800;
  }
  .note {
    font-size: 14px;
    color: var(--muted);
    margin-top: 20px;
    background: var(--paper-2);
    border-radius: 10px;
    padding: 14px 18px;
  }
  .note b {
    color: var(--ink);
  }
  .tlist {
    list-style: none;
    counter-reset: t;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .tlist li {
    counter-increment: t;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .tlist li::before {
    content: counter(t);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 26px;
    color: var(--wine);
    line-height: 1;
  }
  .tlist li p {
    margin: 0;
    font-size: 16px;
  }
  .cta-band {
    margin: 64px 0 0;
    background: var(--ink);
    color: #efe6d8;
    border-radius: 16px;
    padding: 44px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cta-band h2 {
    color: #fff;
    font-size: clamp(24px, 3vw, 34px);
  }
  .cta-band p {
    color: #c6bcac;
    margin: 8px 0 0;
    font-size: 15px;
  }
  .cta-band .btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cta-band a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14px 24px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 8px;
    text-decoration: none;
  }
  .cta-band a.prim {
    background: var(--wine);
    color: #fff;
  }
  .cta-band a.prim:hover {
    background: var(--wine-dark);
  }
  .cta-band a.ghost {
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: #fff;
  }
  .cta-band a.ghost:hover {
    background: #fff;
    color: var(--ink);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .step {
    margin: 0;
  }
  .step-btn {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 14px 18px;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition:
      border-color 0.18s,
      transform 0.18s,
      box-shadow 0.18s,
      background 0.18s;
  }
  .step-btn:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(20, 12, 6, 0.08);
  }
  .step-btn:focus-visible {
    outline: 2px solid var(--wine);
    outline-offset: 2px;
  }
  .step .n {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--paper-2);
    border: 2px solid var(--border);
    color: var(--wine);
    display: flex;
