---
import { path } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import { SITE } from "../lib/site";

const faqs = [
  {
    question: "Was ist ein Theaterverlag?",
    answer:
      "Ein Theaterverlag (auch Bühnenverlag) vertritt Theaterstücke: Er vermittelt Aufführungsrechte an Bühnen, betreut Autorinnen und Autoren und stellt Textmaterial wie Leseproben und Rollensätze bereit.",
  },
  {
    question: "Was ist der Unterschied zwischen Theaterverlag und Buchverlag?",
    answer:
      "Ein Buchverlag verkauft in der Regel gedruckte oder digitale Lesetexte. Ein Theaterverlag vermarktet vor allem das Recht zur öffentlichen Aufführung und liefert dafür die nötigen Materialien an Ensembles.",
  },
  {
    question: "Braucht eine Amateurtheatergruppe einen Theaterverlag?",
    answer:
      "Ja, sobald ein urheberrechtlich geschütztes Stück öffentlich aufgeführt wird. Ohne Vertrag bzw. Aufführungserlaubnis sind Aufführungen in der Regel nicht gestattet.",
  },
  {
    question: "Was macht der Theaterverlag Arno Boas?",
    answer:
      "Er ist ein Bühnenverlag fürs Amateurtheater mit über 250 Stücken: Komödien, Krimis, Märchen, Dramen und mehr — in verständlicher Umgangssprache, leicht in jeden Dialekt übertragbar oder auf Hochdeutsch spielbar.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Was ist ein Theaterverlag?",
  description:
    "Erklärung: Was Theaterverlage bzw. Bühnenverlage tun, wofür Aufführungsrechte nötig sind und wie Amateurtheater damit arbeiten.",
  inLanguage: "de",
  author: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: `${SITE.url}/was-ist-ein-theaterverlag`,
};

const definedTermLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: "Theaterverlag",
  alternateName: ["Bühnenverlag", "Bühnenverlag für Amateurtheater"],
  description:
    "Ein Theaterverlag vertritt Theaterstücke, vermittelt Aufführungsrechte an Bühnen und stellt Text- und Aufführungsmaterial bereit.",
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "Theater und Aufführungsrecht",
  },
};
---

<BaseLayout
  title="Was ist ein Theaterverlag?"
  description="Theaterverlag erklärt: Aufgaben eines Bühnenverlags, Aufführungsrechte, Rollensätze — und wie Amateurtheater damit arbeiten."
  jsonLd={[articleLd, definedTermLd, faqLd]}
>
  <SiteHeader />

  <section class="intro">
    <div class="wrap narrow">
      <span class="cap-label">Wissen · Bühnenrecht</span>
      <h1>Was ist ein Theaterverlag?</h1>
      <p class="lead">
        Kurz gesagt: Ein Theaterverlag — oft auch Bühnenverlag genannt — ist der
        Partner zwischen Autorinnen und Autoren und den Bühnen, die ihre Stücke
        spielen möchten. Er kümmert sich um Rechte, Texte und den Weg zur
        Aufführung.
      </p>
    </div>
  </section>

  <section class="wrap narrow body">
    <h2>Definition</h2>
    <p>
      Ein <strong>Theaterverlag</strong> vertritt dramatische Werke für die
      Bühne. Anders als ein Buchverlag steht nicht das Lesebuch im Mittelpunkt,
      sondern die <strong>öffentliche Aufführung</strong>: Wer ein Stück spielen
      will, braucht in der Regel die Erlaubnis der Rechteinhaber — und genau
      dafür ist der Theaterverlag da.
    </p>
    <p>
      Typische Kundinnen und Kunden sind professionelle Theater, aber auch
      Amateurtheater, Schul- und Jugendbühnen sowie Seniorenensembles. Der
      Verlag kennt sein Repertoire, die Spielbarkeit der Stücke und die
      Bedingungen für die Nutzung.
    </p>

    <h2>Was macht ein Theaterverlag?</h2>
    <p>Zu den zentralen Aufgaben gehören:</p>
    <ul>
      <li>
        <b>Aufführungsrechte vermitteln</b> — Ensembles erhalten die Erlaubnis,
        ein Stück öffentlich zu spielen, meist über einen Aufführungsvertrag.
      </li>
      <li>
        <b>Autorinnen und Autoren vertreten</b> — Der Verlag betreut Texte,
        pflegt das Programm und sorgt dafür, dass Stücke gefunden und gespielt
        werden.
      </li>
      <li>
        <b>Material bereitstellen</b> — Leseproben, Ansichtsexemplare,
        Regie- und Rollentexte, oft als Selbstkopie oder als gedruckter
        Rollensatz.
      </li>
      <li>
        <b>Beraten</b> — Welche Stücke passen zu Besetzung, Spieldauer, Genre
        und Spielort? Theaterverlage helfen bei der Stückwahl.
      </li>
      <li>
        <b>Abrechnung der Aufführungsgebühren</b> — Für die Nutzung des Werks
        fallen Gebühren an; der Verlag regelt das mit den Bühnen.
      </li>
    </ul>

    <h2>Theaterverlag und Buchverlag — der Unterschied</h2>
    <p>
      Ein Buchverlag veröffentlicht Texte zum Lesen. Ein Theaterverlag
      organisiert vor allem das <strong>Aufführungsgeschäft</strong>: Rechte,
      Verträge, Texthefte für die Probe und die Vorstellung. Manche Häuser
      verbinden beides — der Kern des Bühnenverlags bleibt aber die Arbeit mit
      Ensembles und Aufführungen.
    </p>

    <h2>Warum Amateurtheater Theaterverlage brauchen</h2>
    <p>
      Auch Laienbühnen führen urheberrechtlich geschützte Stücke auf. Ohne
      entsprechende Erlaubnis sind öffentliche Aufführungen in der Regel nicht
      erlaubt — unabhängig davon, ob Eintritt verlangt wird. Der Theaterverlag
      macht den Weg rechtssicher: Stück finden, lesen, anfragen, Vertrag
      schließen, spielen.
    </p>
    <p>
      Für viele Gruppen ist außerdem wichtig, dass die Texte
      <strong>spielbar</strong> sind: klare Sprache, flexible Besetzung,
      überschaubare Bühnenbilder — genau darauf spezialisieren sich Verlage fürs
      Amateurtheater.
    </p>

    <h2>Beispiel: Theaterverlag Arno Boas</h2>
    <p>
      Der {SITE.name} ist seit {SITE.founded} ein Bühnenverlag für das
      Amateurtheater. Im Programm liegen über 250 Stücke — von der Komödie über
      den Krimi bis zum Märchen und Drama. Die Werke sind in verständlicher
      Umgangssprache verfasst und lassen sich leicht in jeden Dialekt
      übertragen oder auf Hochdeutsch spielen.
    </p>
    <p>
      Ensembles können Stücke filtern, merken und anfragen; zu abendfüllenden
      Titeln gibt es kostenlose PDF-Leseproben. Autorinnen und Autoren können
      Manuskripte als PDF einreichen.
    </p>
    <div class="cta-row">
      <a class="btn" href={path("/theaterstuecke")}>Zum Repertoire</a>
      <a class="btn ghost" href={path("/ueber-den-verlag")}>Über den Verlag</a>
      <a class="btn ghost" href={path("/preise-und-bedingungen")}
        >Preise &amp; Bedingungen</a
      >
    </div>
  </section>

  <NewsletterSignup />

  <section class="wrap narrow faq-sec">
    <div class="faq-h">
      <span class="cap-label">Häufige Fragen</span>
      <h2>Kurz beantwortet</h2>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="ic">
                <i class="ti ti-plus" aria-hidden="true" />
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }
  .intro {
    padding: 52px 0 8px;
  }
  .intro h1 {
    font-size: clamp(36px, 5.6vw, 68px);
    line-height: 0.96;
    margin: 12px 0 0;
  }
  .lead {
    font-size: 19px;
    margin: 18px 0 0;
    max-width: 62ch;
    color: var(--text);
  }
  .body {
    padding-block: 28px 20px;
  }
  .body h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.05;
    margin: 36px 0 14px;
  }
  .body p {
    margin: 0 0 16px;
    max-width: 68ch;
  }
  .body ul {
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
    max-width: 68ch;
  }
  .body li {
    padding-left: 18px;
    position: relative;
  }
  .body li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--wine);
  }
  .body li b {
    color: var(--ink);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--wine);
    color: #fff;
    text-decoration: none;
    border: 1px solid var(--wine);
    padding: 13px 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 6px;
  }
  .btn:hover {
    background: var(--wine-dark);
    border-color: var(--wine-dark);
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn.ghost:hover {
    color: var(--wine);
    border-color: var(--wine);
    background: transparent;
  }
  .faq-sec {
    padding-block: 24px 48px;
  }
  .faq-h {
    margin-bottom: 22px;
  }
  .faq-h h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1;
    margin-top: 10px;
  }
  .faq {
    border-top: 2px solid var(--ink);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: var(--ink);
    line-height: 1.12;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .ic {
    flex: none;
    color: var(--wine);
    font-size: 22px;
    transition: transform 0.2s;
    line-height: 1;
  }
  .faq details[open] summary .ic {
    transform: rotate(45deg);
  }
  .faq summary:hover {
    color: var(--wine);
  }
  .faq details p {
    margin: 0 0 22px;
    font-size: 16px;
    color: var(--text);
    max-width: 78ch;
  }
</style>
