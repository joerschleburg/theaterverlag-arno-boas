---
import { path } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import { SITE } from "../lib/site";

const onlineHref = path("/auffuehrungsmeldung");
const pdfHref = path("/formulare/auffuehrungsmeldung.pdf");
---

<BaseLayout
  title="Formulare"
  description="Aufführungsmeldung online oder als PDF — Theaterverlag Arno Boas."
>
  <SiteHeader />

  <section class="intro">
    <div class="wrap narrow">
      <span class="cap-label">Service</span>
      <h1>Formulare</h1>
      <p class="lead">
        Mit der Aufführungsmeldung informieren Sie uns über geplante und
        stattgefundene Vorstellungen — digital oder zum Ausdrucken.
      </p>
    </div>
  </section>

  <section class="wrap narrow body">
    <p>Sehr geehrte Damen und Herren,</p>
    <p>
      mit nachfolgendem Formular können Sie uns bequem über alle Aufführungen
      informieren — sowohl über Ihre Pläne (hier bitte keine Prognosen über
      Einnahmen eintragen) als auch über stattgefundene Vorstellungen. Bitte
      geben Sie <strong>unbedingt sämtliche Vorstellungen</strong> an, auch die
      Premiere, auf die Sie eventuell schon eine Anzahlung geleistet haben.
      Diesen Betrag ziehen wir von der Endsumme wieder ab.
    </p>
    <p>
      Rücksendung der PDF-Version bitte an:<br />
      <strong>{SITE.name}</strong><br />
      {SITE.address.street}<br />
      {SITE.address.zip} {SITE.address.city}<br />
      oder per E-Mail an
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <p>Herzlichen Dank<br /><em>Ihr Theaterverlag Arno Boas</em></p>

    <h2>Aufführungsmeldung</h2>
    <div class="cta-row">
      <a class="btn" href={onlineHref}>
        <i class="ti ti-forms" aria-hidden="true" />
        Aufführungsmeldung (Online)
      </a>
      <a class="btn ghost" href={pdfHref} download>
        <i class="ti ti-file-type-pdf" aria-hidden="true" />
        Aufführungsmeldung (PDF)
      </a>
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }
  .intro {
    padding: 48px 0 8px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 10px 0 14px;
    line-height: 1.05;
  }
  .lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 58ch;
    margin: 0;
  }
  .body {
    padding: 24px 0 90px;
  }
  .body p {
    margin: 0 0 16px;
    font-size: 16px;
    line-height: 1.65;
    max-width: 68ch;
  }
  .body a {
    color: var(--wine);
    font-weight: 600;
  }
  .body h2 {
    font-size: clamp(24px, 2.8vw, 32px);
    margin: 36px 0 16px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: #fff !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.4px;
    padding: 14px 20px;
    border-radius: 8px;
    border: 1px solid var(--ink);
  }
  .btn:hover {
    background: var(--wine);
    border-color: var(--wine);
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink) !important;
  }
  .btn.ghost:hover {
    color: #fff !important;
    background: var(--wine);
    border-color: var(--wine);
  }
  .btn i {
    font-size: 18px;
  }
</style>
