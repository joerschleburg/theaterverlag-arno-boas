---
import { path } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import { SITE } from "../lib/site";
import {
  getGenreIndexWithCounts,
  overviewHref,
  stueckHref,
} from "../lib/stuecke";

const genreIndex = getGenreIndexWithCounts();

/**
 * Kuratierte Startseiten-Inhalte 1:1 aus der Editorial-Referenz.
 * Auswahl später über Backend; Links zeigen auf echte Slugs, wo vorhanden.
 */
const feature = {
  slug: "mord-im-moor",
  kicker: "Kriminalkomödie · gn-28",
  titelLines: ["Mord", "im Moor"] as const,
  empfehlung: "Empfehlung · von Jochen Wiltschko",
  headline: "Ein Toter, ein Moor, jede Menge Verdächtige.",
  dek: 'Als in der „Villa Strohmann" ein Mord geschieht und die Leiche spurlos verschwindet, erwacht in Hobby-Detektivin Euphelia der Jagdinstinkt.',
  specs: [
    ["Besetzung", "5 Herren · 4 Damen"],
    ["Spieldauer", "ca. 105 Minuten"],
    ["Bühnenbild", "ein Raum"],
    ["Rollensatz", "175,00 €"],
  ] as const,
};

const neu = [
  {
    href: stueckHref("pension-rhonblick"),
    g: "Komödie",
    spiel: "abendfüllend",
    titel: "Pension Rhönblick",
    meta: ["4 H · 6 D", "120 Min.", "ein Bühnenbild"],
  },
  {
    href: stueckHref("an-einem-tag-im-marz"),
    g: "Drama · ausgezeichnet",
    spiel: "abendfüllend",
    titel: "An einem Tag im März",
    meta: ["4 H · 3 D", "100 Min.", "Lamathea-Preis"],
  },
  {
    href: stueckHref("der-frosch-konig-oder-wenns-handy-in-den-brunnen-fallt"),
    g: "Märchen",
    spiel: "Familienstück",
    titel: "Der Froschkönig",
    meta: ["3 H · 4 D", "70 Min.", "frei nach Grimm"],
  },
  {
    href: overviewHref({ genre: "Weihnachten" }),
    g: "Weihnachten",
    spiel: "Familienstück",
    titel: "Sternschnuppenzauber",
    meta: ["4 H · 5 D", "60 Min.", "für die ganze Familie"],
  },
];

const faqs = [
  {
    question: "Was ist der Theaterverlag Arno Boas?",
    answer:
      "Ein 1997 gegründeter Bühnenverlag für das Amateurtheater mit über 250 Stücken von rund 40 Autorinnen und Autoren — von der Komödie über den Krimi bis zum Drama.",
  },
  {
    question: "Für wen sind die Stücke geeignet?",
    answer:
      "Für Theatervereine, Amateurbühnen, Schul- und Jugendgruppen sowie Seniorentheater. Alle Werke sind in verständlicher Umgangssprache verfasst und dadurch leicht in jeden Dialekt übertragbar oder auf Hochdeutsch spielbar.",
  },
  {
    question: "Wie finde ich ein passendes Stück?",
    answer:
      "Über die Suche und die Filter nach Genre, Ensemblegröße (Herren- und Damenrollen), Spielort und Dauer. Gemerkte Stücke lassen sich anschließend gebündelt anfragen.",
  },
  {
    question: "Kann ich ein Stück vor der Aufführung lesen?",
    answer:
      "Ja. Zu den abendfüllenden Stücken gibt es eine kostenlose Leseprobe als PDF mit rund der Hälfte des Stücks. Das komplette Ansichtsexemplar können Sie vier Wochen unverbindlich anfordern.",
  },
  {
    question: "Was kostet eine Aufführung?",
    answer:
      "Die Gebühr richtet sich nach Spielart und Zahl der Aufführungen — bei abendfüllenden Stücken 10 % der Eintrittseinnahmen, mindestens 50 € je Aufführung (zzgl. 7 % MwSt). Alle Details finden Sie unter „Preise & Bedingungen\".",
  },
  {
    question: "Wie kann ich ein Stück anfragen oder bestellen?",
    answer:
      "Merken Sie sich Stücke über die Merkliste und senden Sie eine gebündelte Anfrage — wahlweise mit Wunsch nach Leseprobe, Ansichtsexemplar, gedrucktem Rollensatz oder Aufführung.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: String(SITE.founded),
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    postalCode: SITE.address.zip,
    addressLocality: SITE.address.city,
    addressCountry: "DE",
  },
};
---

<BaseLayout
  title={SITE.name + " — Repertoire"}
  description="Über 250 Bühnenstücke fürs Amateurtheater. Theaterverlag Arno Boas — gegründet 1997."
  headerVariant="hero"
  jsonLd={[orgLd, faqLd]}
>
  <Hero />

  <section class="sec">
    <div class="wrap">
      <SectionHead folio="№&nbsp;01" title="Im Rampenlicht" />
      <div class="feature">
        <div class="fpo">
          <i class="ti ti-detective ic" aria-hidden="true"></i>
          <span class="t">{feature.kicker}</span>
          <span class="n">
            {feature.titelLines[0]}<br />{feature.titelLines[1]}
          </span>
        </div>
        <div class="ftx">
          <span class="cap-label">{feature.empfehlung}</span>
          <h3>{feature.headline}</h3>
          <p class="dek">{feature.dek}</p>
          <ul class="specs">
            {
              feature.specs.map(([k, v]) => (
                <li>
                  <span>{k}</span>
                  <span>{v}</span>
                </li>
              ))
            }
          </ul>
          <div class="flinks">
            <a href={stueckHref(feature.slug)}>Zum Stück</a>
            <a href={stueckHref(feature.slug)}>Leseprobe (PDF)</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="endmark"><i class="ti ti-masks-theater" aria-hidden="true"></i></div>

  <section class="sec">
    <div class="wrap">
      <SectionHead folio="№&nbsp;02" title="Neu im Repertoire" />
      <div class="list">
        {
          neu.map((s) => (
            <a class="li" href={s.href}>
              <div class="lt">
                <span class="g">{s.g}</span>
                <span>{s.spiel}</span>
              </div>
              <div class="lh">{s.titel}</div>
              <div class="lm">
                {s.meta.map((m) => (
                  <span>{m}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <div class="more">
        <a href={path("/theaterstuecke")}>Alle Stücke ansehen →</a>
      </div>
    </div>
  </section>

  <div class="endmark"><i class="ti ti-masks-theater" aria-hidden="true"></i></div>

  <section class="sec">
    <div class="wrap">
      <SectionHead folio="№&nbsp;03" title="Nach Genre stöbern" />
      <div class="idx">
        {
          genreIndex.map((g) => (
            <a
              href={overviewHref({
                genre:
                  g.label === "Kinder & Jugend" ? "Für Jugendliche" : g.label,
              })}
            >
              <span class="n">{g.n}</span>
              <span class="nm">{g.label}</span>
              <span class="ld" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="pq">
      <div class="pq-inner">
        <img
          class="pq-portrait"
          src={path("/images/arno.jpg")}
          alt="Arno Boas"
          width="340"
          height="400"
          loading="lazy"
        />
        <div class="pq-text">
          <blockquote>
            „Vielfalt war und bleibt Trumpf unseres Verlages."
          </blockquote>
          <div class="sig">Arno Boas</div>
          <cite>Verlagsgründer · Autor · Theatermensch</cite>
          <a class="tlink" href={path("/autoren/arno-boas")}
            >Mehr über Arno Boas erfahren →</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="wrap about-inner">
      <div>
        <span class="cap-label">Über den Verlag</span>
        <h2>Von Theaterleuten, für Theaterleute.</h2>
        <p class="lead">
          Seit 1997 stehen wir für lebendige Bühnenstücke in verständlicher
          Umgangssprache – leicht in jeden Dialekt übertragbar und auf
          Hochdeutsch spielbar. Vom abendfüllenden Stück über Einakter bis zum
          Sketch: Vielfalt ist unser Markenzeichen.
        </p>
        <div class="stats">
          <div class="stat"><b>250+</b><span>Theaterstücke</span></div>
          <div class="stat"><b>40</b><span>Autorinnen und Autoren</span></div>
          <div class="stat"><b>1997</b><span>gegründet</span></div>
        </div>
        <a class="tlink" href={path("/ueber-den-verlag")}
          >Mehr über den Verlag →</a
        >
      </div>
      <div>
        <div
          class="about-img"
          role="img"
          aria-label="Aufführung aus dem Verlagsrepertoire"
          style={`background-image: url('${path("/images/hero_2.jpg")}')`}
        >
        </div>
        <p class="cap">Aus einer Aufführung im Verlagsrepertoire</p>
      </div>
    </div>
  </section>

  <section class="news" aria-labelledby="nl-title">
    <div class="news-inner">
      <div class="nl-ic"><i class="ti ti-mail" aria-hidden="true"></i></div>
      <span class="cap-label">Newsletter</span>
      <h2 id="nl-title">Bleiben wir in Kontakt</h2>
      <p>
        Neue Stücke und Aktuelles aus dem Verlag – ein paar Mal im Jahr, herzlich
        und ganz ohne Werbeflut.
      </p>
      <form onsubmit="return false;">
        <input
          type="email"
          placeholder="Ihre E-Mail-Adresse"
          aria-label="E-Mail-Adresse"
          disabled
        />
        <button type="button" disabled>Anmelden</button>
      </form>
      <div class="nl-note">Kein Spam. Jederzeit abbestellbar.</div>
    </div>
  </section>

  <section class="sec faq-sec">
    <div class="wrap">
      <div class="head">
        <div class="l"><h2>Häufige Fragen</h2></div>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>
                {item.question}
                <span class="ic">
                  <i class="ti ti-plus" aria-hidden="true" />
                </span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .sec {
    padding: 104px 0 0;
  }
  .faq-sec {
    padding-bottom: 24px;
  }
  .head {
    border-bottom: 2.5px solid var(--ink);
    padding-bottom: 14px;
    margin-bottom: 46px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 26px;
    flex-wrap: wrap;
  }
  .head .l {
    display: flex;
    align-items: baseline;
    gap: 26px;
    min-width: 0;
  }
  .head h2 {
    font-size: clamp(30px, 4.4vw, 58px);
    line-height: 0.9;
  }

  .feature {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    border: 1px solid var(--ink);
  }
  .fpo {
    position: relative;
    min-height: 460px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
    overflow: hidden;
    background: var(--g-krimi);
  }
  .fpo .ic {
    position: absolute;
    bottom: -30px;
    right: -14px;
    font-size: 230px;
    opacity: 0.12;
  }
  .fpo .t {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: var(--font-body);
    font-weight: 600;
    opacity: 0.85;
  }
  .fpo .n {
    position: relative;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 66px);
    line-height: 1;
  }
  .ftx {
    padding: 44px 46px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--surface);
  }
  .ftx h3 {
    font-family: var(--font-head);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 0.98;
    margin: 12px 0 16px;
  }
  .dek {
    font-size: 17px;
    color: var(--text);
    margin: 0 0 24px;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    border-top: 1px solid var(--ink);
  }
  .specs li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .specs li span:first-child {
    color: var(--muted);
    letter-spacing: 0.5px;
  }
  .specs li span:last-child {
    font-weight: 500;
  }
  .flinks {
    display: flex;
    gap: 26px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .flinks a {
    color: var(--wine);
    text-decoration: none;
    border-bottom: 2px solid var(--wine);
    padding-bottom: 3px;
  }

  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 64px;
  }
  .li {
    display: block;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition: padding 0.15s;
  }
  .li:hover {
    padding-left: 12px;
  }
  .lt {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 11.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    gap: 12px;
  }
  .lt .g {
    color: var(--wine);
    font-weight: 700;
  }
  .lh {
    font-family: var(--font-head);
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 0.94;
    font-weight: 800;
  }
  .li:hover .lh {
    color: var(--wine);
  }
  .lm {
    margin-top: 12px;
    font-size: 13px;
    color: var(--muted);
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .more {
    margin-top: 38px;
  }
  .more a {
    color: var(--ink);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-bottom: 2px solid var(--wine);
    padding-bottom: 4px;
  }

  .idx {
    border-top: 1px solid var(--ink);
  }
  .idx a {
    display: flex;
    align-items: baseline;
    gap: 22px;
    padding: 24px 4px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--ink);
    transition:
      padding 0.15s,
      color 0.15s;
  }
  .idx a:hover {
    padding-left: 16px;
    color: var(--wine);
  }
  .idx .n {
    font-family: var(--font-head);
    font-size: 15px;
    color: var(--wine);
    width: 36px;
    flex: none;
  }
  .idx .nm {
    font-family: var(--font-head);
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 0.86;
    font-weight: 800;
  }
  .idx .ld {
    flex: 1;
    border-bottom: 1px dotted var(--hair);
    transform: translateY(-8px);
  }

  .pq {
    padding: 110px 0;
  }
  .pq-inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 64px;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
    text-align: left;
  }
  .pq-portrait {
    width: 340px;
    height: 400px;
    border-radius: 10px;
    object-fit: cover;
    object-position: center;
    display: block;
    box-shadow: 0 24px 50px rgba(20, 12, 6, 0.28);
  }
  .pq blockquote {
    font-family: var(--font-head);
    font-size: clamp(28px, 3.9vw, 52px);
    line-height: 1.05;
    margin: 0;
    color: var(--ink);
    font-weight: 800;
  }
  .sig {
    font-family: var(--font-head);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(22px, 2.3vw, 30px);
    color: var(--wine);
    line-height: 1;
    margin-top: 22px;
  }
  .pq cite {
    display: block;
    margin-top: 14px;
    font-style: normal;
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .pq :global(.tlink),
  .about :global(.tlink) {
    margin-top: 26px;
  }
  .about :global(.tlink) {
    margin-top: 30px;
  }

  .about {
    padding: 104px 0;
    border-top: 1px solid var(--ink);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    gap: 70px;
    align-items: start;
  }
  .about h2 {
    font-size: clamp(32px, 4.4vw, 56px);
    margin: 14px 0 20px;
    line-height: 0.92;
  }
  .lead {
    font-size: 19px;
    color: var(--text);
    margin: 0;
  }
  .lead::first-letter {
    font-family: var(--font-head);
    font-size: 74px;
    float: left;
    line-height: 0.72;
    padding: 8px 14px 0 0;
    color: var(--wine);
  }
  .stats {
    display: flex;
    gap: 48px;
    margin-top: 38px;
    flex-wrap: wrap;
    border-top: 2.5px solid var(--ink);
    padding-top: 26px;
  }
  .stat b {
    font-family: var(--font-head);
    font-size: 48px;
    color: var(--wine);
    display: block;
    line-height: 0.8;
  }
  .stat span {
    font-size: 13px;
    color: var(--muted);
  }
  .about-img {
    height: 520px;
    background-color: #2a1a20;
    background-position: center;
    background-size: cover;
  }
  .cap {
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .news {
    background: transparent;
    padding: 48px 24px 18px;
  }
  .news-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    background: linear-gradient(165deg, #fbeeda 0%, #f3e5ce 100%);
    border: 1px solid #e7d9be;
    border-radius: 22px;
    padding: 54px 44px;
    box-shadow: 0 18px 42px rgba(20, 12, 6, 0.08);
  }
  .nl-ic {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: var(--wine);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
    margin-bottom: 16px;
    box-shadow: 0 8px 20px rgba(207, 85, 26, 0.3);
  }
  .news :global(.cap-label) {
    color: var(--wine);
  }
  .news h2 {
    color: var(--ink);
    font-size: clamp(28px, 4vw, 46px);
    margin-top: 12px;
    line-height: 1;
  }
  .news p {
    color: var(--text);
    margin: 14px auto 26px;
    font-size: 16.5px;
    max-width: 46ch;
  }
  .news form {
    display: flex;
    max-width: 470px;
    margin: 0 auto;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px;
    box-shadow: 0 6px 18px rgba(20, 12, 6, 0.07);
  }
  .news input {
    flex: 1;
    min-width: 150px;
    padding: 13px 20px;
    border: none;
    font-family: var(--font-body);
    font-size: 15px;
    background: transparent;
    color: var(--ink);
    outline: none;
  }
  .news input:disabled,
  .news button:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }
  .news button {
    background: var(--wine);
    color: #fff;
    border: none;
    border-radius: 100px;
    padding: 13px 28px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .nl-note {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 14px;
  }

  .faq {
    border-top: 2.5px solid var(--ink);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(20px, 2vw, 27px);
    color: var(--ink);
    line-height: 1.12;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .ic {
    flex: none;
    color: var(--wine);
    font-size: 24px;
    transition: transform 0.2s;
    line-height: 1;
  }
  .faq details[open] summary .ic {
    transform: rotate(45deg);
  }
  .faq summary:hover {
    color: var(--wine);
  }
  .faq details p {
    margin: 0 0 24px;
    font-size: 17px;
    color: var(--text);
    max-width: 80ch;
  }

  @media (max-width: 900px) {
    .feature,
    .list,
    .about-inner,
    .pq-inner {
      grid-template-columns: 1fr;
    }
    .fpo {
      min-height: 300px;
    }
    .about-img {
