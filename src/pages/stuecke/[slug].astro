---
import { path } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StickyKatalog from "../../components/StickyKatalog.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import {
  autorHref,
  formatBesetzung,
  formatSpielort,
  getRelatedStuecke,
  getStueckBySlug,
  getStuecke,
  LESEPROBE_LABEL,
  leseprobeFormatLabel,
  leseprobeHref,
  overviewHref,
  stueckHref,
} from "../../lib/stuecke";
import { SITE, genreFilterLabel } from "../../lib/site";

export function getStaticPaths() {
  return getStuecke().map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const stueck = getStueckBySlug(slug!);
if (!stueck) {
  return Astro.redirect(path("/theaterstuecke"));
}

const besetzung = formatBesetzung(stueck);
const spielortLabel = formatSpielort(stueck.spielort);
const authorLink = autorHref(stueck.autor);
const related = getRelatedStuecke(stueck, 3);
const genrePrimary = stueck.kategorien[0] || "Theaterstück";
const genreFilter = genreFilterLabel(genrePrimary);
const genreDisplay = stueck.kategorien.map(genreFilterLabel).join(", ");
const sampleHref = leseprobeHref(stueck);
const sampleFormat = leseprobeFormatLabel(stueck.leseprobe?.format);
const besetzungHinweis =
  stueck.besetzung_hinweis &&
  !/^\d+$/.test(String(stueck.besetzung_hinweis).trim())
    ? String(stueck.besetzung_hinweis).trim()
    : undefined;

const specs: { label: string; value: string }[] = [
  { label: "Genre", value: genreDisplay },
];
if (besetzung) specs.push({ label: "Besetzung", value: besetzung });
if (typeof stueck.spieldauer_min === "number") {
  specs.push({
    label: "Spieldauer",
    value: `ca. ${stueck.spieldauer_min} Min.`,
  });
}
if (spielortLabel) specs.push({ label: "Spielort", value: spielortLabel });
specs.push({ label: "Spielart", value: stueck.spielart_geschaetzt });
if (stueck.kuerzel) specs.push({ label: "Kürzel", value: stueck.kuerzel });
specs.push({ label: "Dialekt", value: "frei übertragbar" });

const faqs = [
  {
    question: `Wie bekomme ich eine Leseprobe zu „${stueck.titel}"?`,
    answer: sampleHref
      ? `Die Leseprobe zeigt 50 % des Inhalts und steht zum direkten Download bereit — ohne Anmeldung, als ${sampleFormat || "PDF oder Word"}. Das komplette Ansichtsexemplar können Sie über die Merkliste vier Wochen unverbindlich anfordern.`
      : "Die Leseprobe (50 % des Inhalts) folgt in Kürze als direkter Download — ohne Anmeldung, als PDF oder Word. Das komplette Ansichtsexemplar können Sie über die Merkliste vier Wochen unverbindlich anfordern.",
  },
  ...(besetzung
    ? [
        {
          question: `Was bedeutet die Besetzung „${besetzung}"?`,
          answer: besetzungHinweis
            ? `Sie nennt die Zahl der Herren- und Damenrollen. Hinweis zur Besetzung: ${besetzungHinweis}`
            : "Sie nennt die Zahl der Herren- und Damenrollen. Viele Stücke lassen sich flexibel besetzen.",
        },
      ]
    : []),
  {
    question: "Was kostet die Aufführung?",
    answer:
      "Bei abendfüllenden Stücken 10 % der Eintrittseinnahmen, mindestens 50 € je Aufführung (zzgl. 7 % MwSt); beim Komplettrollensatz kommt der Heftpreis hinzu. Einakter, Kurzstücke und Sketche haben Pauschalen — Details unter „Preise & Bedingungen\".",
  },
  {
    question: "Können wir das Stück in unserem Dialekt spielen?",
    answer:
      "Ja. Die Stücke sind in verständlicher Umgangssprache verfasst und leicht in jeden Dialekt übertragbar oder auf Hochdeutsch spielbar.",
  },
  {
    question: `Wie frage ich „${stueck.titel}" an?`,
    answer:
      "Über „Für Aufführung anfragen\" oder indem Sie das Stück merken und gebündelt mit weiteren Titeln anfragen — wahlweise für Ansichtsexemplar, Rollensatz oder Beratung. Die Leseprobe (50 % des Inhalts) laden Sie direkt herunter.",
  },
];

const creativeWorkLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: stueck.titel,
  alternateName: stueck.kuerzel || undefined,
  genre: stueck.kategorien,
  description:
    stueck.inhalt ||
    stueck.untertitel ||
    `${stueck.titel} — Bühnenstück im Theaterverlag Arno Boas.`,
  url: `${SITE.url}/stuecke/${stueck.slug}`,
  inLanguage: "de",
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
  },
};
if (stueck.autor) {
  creativeWorkLd.author = { "@type": "Person", name: stueck.autor };
}
if (stueck.kuerzel) {
  creativeWorkLd.identifier = stueck.kuerzel;
}
if (typeof stueck.spieldauer_min === "number") {
  creativeWorkLd.timeRequired = `PT${stueck.spieldauer_min}M`;
}

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Theaterstücke",
      item: `${SITE.url}/theaterstuecke`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: genreFilter,
      item: `${SITE.url}/theaterstuecke?genre=${encodeURIComponent(genreFilter)}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: stueck.titel,
      item: `${SITE.url}/stuecke/${stueck.slug}`,
    },
  ],
};

const descParts = [
  stueck.titel,
  stueck.untertitel,
  stueck.inhalt ? stueck.inhalt.slice(0, 140).replace(/\s+/g, " ").trim() + "…" : null,
  besetzung,
  typeof stueck.spieldauer_min === "number"
    ? `ca. ${stueck.spieldauer_min} Min.`
    : null,
  "Theaterverlag Arno Boas",
].filter(Boolean);

const pageDescription = descParts.join(" · ").slice(0, 300);
---

<BaseLayout
  title={stueck.titel}
  description={pageDescription}
  jsonLd={[creativeWorkLd, faqLd, breadcrumbLd]}
>
  <SiteHeader active="/theaterstuecke" />

  <div class="wrap crumb">
    <a href={path("/theaterstuecke")}>Theaterstücke</a>
    <span class="sep">›</span>
    <a href={overviewHref({ genre: genreFilter })}>{genreFilter}</a>
    <span class="sep">›</span>
    <span>{stueck.titel}</span>
  </div>

  <section class="wrap detail">
    <div class="d-main">
      <span class="cap-label">{genreFilter}</span>
      <h1>{stueck.titel}</h1>
      {
        stueck.untertitel && <p class="d-sub">{stueck.untertitel}</p>
      }
      {
        stueck.autor && (
          <p class="d-author">
            von{" "}
            {authorLink ? (
              <a href={authorLink}>
                <b>{stueck.autor}</b>
              </a>
            ) : (
              <b>{stueck.autor}</b>
            )}
          </p>
        )
      }

      <div class="d-body">
        {
          stueck.inhalt && (
            <>
              <h2>Inhalt</h2>
              {stueck.inhalt.split(/\n\n+/).map((para) => (
                <p>{para}</p>
              ))}
            </>
          )
        }
        {
          stueck.buehnenbild &&
            stueck.buehnenbild !== stueck.untertitel &&
            stueck.buehnenbild !== stueck.titel && (
              <>
                <h2>Bühnenbild</h2>
                <p>{stueck.buehnenbild}</p>
              </>
            )
        }
        {
          besetzungHinweis && (
            <div class="cast-note">
              <span class="cn-label">Besetzungshinweis</span>
              <p>{besetzungHinweis}</p>
            </div>
          )
        }

        <h2>Bestellung &amp; Aufführung</h2>
        <div class="order">
          <div class="oi">
            <i class="ti ti-file-text" aria-hidden="true" />
            <div>
              <b>{LESEPROBE_LABEL}</b>
              <span
                >Kostenloser Download, ohne Anmeldung. Format je Stück PDF oder
                Word.{sampleFormat ? ` Hier: ${sampleFormat}.` : ""}</span
              >
              {
                sampleHref ? (
                  <a class="oi-dl" href={sampleHref} download>
                    {LESEPROBE_LABEL} herunterladen
                    {sampleFormat ? ` (${sampleFormat})` : ""}
                  </a>
                ) : (
                  <span class="oi-soon">Download folgt in Kürze.</span>
                )
              }
            </div>
          </div>
          <div class="oi">
            <i class="ti ti-copy" aria-hidden="true" />
            <div>
              <b>Datei oder Heft zum Selbstkopieren</b>
              <span
                >Sie erhalten das komplette Stück und vervielfältigen die Rollen
                selbst.</span
              >
            </div>
          </div>
          <div class="oi">
            <i class="ti ti-books" aria-hidden="true" />
            <div>
              <b>Gedruckter Rollensatz</b>
              <span
                >Fertig gedruckte Rollenhefte für Ihr Ensemble — bequem geliefert.</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <aside class="aside">
      <div class="card">
        <div class="ct">Auf einen Blick</div>
        <ul class="specs">
          {
            specs.map((row) => (
              <li>
                <span>{row.label}</span>
                <span>{row.value}</span>
              </li>
            ))
          }
        </ul>
        {
          besetzungHinweis && (
            <div class="spec-note">
              <span>Besetzungshinweis</span>
              <p>{besetzungHinweis}</p>
            </div>
          )
        }
        {
          typeof stueck.preis_rollensatz === "number" ? (
            <div class="price">
              <span class="pl">Rollensatz ab</span>
              <span class="p"
                >{stueck.preis_rollensatz.toFixed(2).replace(".", ",")} €</span
              >
            </div>
          ) : (
            <div class="price soft">
              <span class="pl">Aufführungsgebühr</span>
              <span class="p-link"
                ><a href={path("/preise-und-bedingungen")}
                  >Preise &amp; Bedingungen</a
                ></span
              >
            </div>
          )
        }
        <div class="cta">
          {
            sampleHref ? (
              <a class="btn primary" href={sampleHref} download>
                <i class="ti ti-download" aria-hidden="true" />
                {LESEPROBE_LABEL}
                {sampleFormat ? ` · ${sampleFormat}` : ""}
              </a>
            ) : (
              <span class="btn primary is-off" title="Datei folgt in Kürze">
                <i class="ti ti-download" aria-hidden="true" />
                {LESEPROBE_LABEL} folgt
              </span>
            )
          }
          <a class="btn ghost" href={path("/kontakt")}>
            <i class="ti ti-mail" aria-hidden="true" /> Für Aufführung anfragen
          </a>
          <button
            type="button"
            class="btn ghost bookmark"
            data-bookmark={stueck.slug}
          >
            <i class="ti ti-bookmark" aria-hidden="true" /> Merken
            <span class="tip">Merken</span>
          </button>
        </div>
        <div class="hint">
          Alle Preise zzgl. Aufführungsgebühr und MwSt. Fragen? Wir beraten Sie
          gern persönlich.
        </div>
      </div>
    </aside>
  </section>

  {
    related.length > 0 && (
      <section class="wrap more-sec">
        <h2>Mehr aus dem Genre</h2>
        <div class="more-grid">
          {related.map((r) => (
            <a class="mli" href={stueckHref(r.slug)}>
              <span class="g">{r.kategorien[0] || r.untertitel}</span>
              <h3>{r.titel}</h3>
              <p>
                {formatBesetzung(r) || r.untertitel || r.spielart_geschaetzt}
                {typeof r.spieldauer_min === "number"
                  ? ` · ca. ${r.spieldauer_min} Min.`
                  : ""}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <NewsletterSignup />

  <section class="wrap faq-sec">
    <div class="faq-h">
      <span class="cap-label">Häufige Fragen</span>
      <h2>Gut zu wissen</h2>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="ic">
                <i class="ti ti-plus" aria-hidden="true" />
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .crumb {
    padding: 22px 0 0;
    font-size: 13px;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--wine);
  }
  .crumb .sep {
    opacity: 0.5;
  }

  .detail {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 56px;
    align-items: start;
    padding-block: 28px 48px;
  }
  .d-main :global(.cap-label) {
    display: inline-block;
  }
  .d-main h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 0.95;
    margin: 12px 0 0;
  }
  .d-sub {
    font-size: 19px;
    color: var(--muted);
    margin: 16px 0 0;
  }
  .d-author {
    margin: 14px 0 0;
    font-size: 16px;
  }
  .d-author a {
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid var(--wine);
  }
  .d-author a:hover {
    color: var(--wine);
  }
  .d-body {
    margin-top: 36px;
  }
  .d-body h2 {
    font-size: clamp(22px, 2.4vw, 28px);
    margin: 28px 0 12px;
  }
  .d-body p {
    margin: 0 0 14px;
    max-width: 62ch;
  }
  .cast-note {
    margin: 28px 0 8px;
    padding: 16px 18px;
    background: var(--paper-2);
    border-left: 3px solid var(--wine);
  }
  .cast-note .cn-label {
    display: block;
    font-size: 11px;
    letter-spacing: 1.6px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--wine);
    margin-bottom: 6px;
  }
  .cast-note p {
    margin: 0;
    font-size: 16px;
    color: var(--ink);
    max-width: none;
  }
  .order {
    display: grid;
    gap: 14px;
    margin-top: 8px;
  }
  .oi {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .oi i {
    color: var(--wine);
    font-size: 22px;
    margin-top: 2px;
  }
  .oi b {
    display: block;
    font-size: 15px;
    color: var(--ink);
  }
  .oi span {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
  .oi-dl {
    display: inline-block;
    margin-top: 10px;
    color: var(--wine);
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
    border-bottom: 2px solid var(--wine);
  }
  .oi-soon {
    display: inline-block;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .aside {
    position: sticky;
    top: 96px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px 22px 20px;
    box-shadow: 0 16px 40px rgba(20, 12, 6, 0.06);
  }
  .ct {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--wine);
    margin-bottom: 14px;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  .specs li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14.5px;
  }
  .specs li span:first-child {
    color: var(--muted);
  }
  .specs li span:last-child {
    text-align: right;
    font-weight: 600;
    color: var(--ink);
  }
  .spec-note {
    margin-top: 14px;
    padding: 12px 14px;
    background: var(--paper-2);
    border-radius: 8px;
  }
  .spec-note span {
    display: block;
    font-size: 10.5px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--wine);
    margin-bottom: 4px;
  }
  .spec-note p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ink);
  }
  .price {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .price .pl {
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
  }
  .price .p {
    font-family: var(--font-head);
    font-size: 28px;
    color: var(--wine);
    font-weight: 800;
  }
  .price.soft .p-link a {
    color: var(--wine);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--wine);
    font-size: 14px;
  }
  .cta {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--wine);
    color: #fff;
    text-decoration: none;
    border: 1px solid var(--wine);
    padding: 13px 18px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 6px;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
    position: relative;
  }
  .btn.primary.is-off {
    opacity: 0.55;
    cursor: default;
    pointer-events: none;
  }
  .btn.ghost.bookmark.on {
    background: var(--wine);
    border-color: var(--wine);
    color: #fff;
  }
  .hint {
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.5;
  }

  .more-sec {
    padding-block: 20px 10px;
  }
  .more-sec h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    margin-bottom: 22px;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .mli {
    text-decoration: none;
    color: inherit;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .mli .g {
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--wine);
    font-weight: 700;
  }
  .mli h3 {
    font-size: clamp(20px, 2vw, 26px);
    margin: 8px 0 8px;
    line-height: 1.05;
  }
  .mli:hover h3 {
    color: var(--wine);
  }
  .mli p {
    margin: 0;
    font-size: 14.5px;
    color: var(--muted);
  }

  .faq-sec {
    padding-block: 24px 48px;
  }
  .faq-h {
    margin-bottom: 22px;
  }
  .faq-h h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1;
    margin-top: 10px;
  }
  .faq {
    border-top: 2px solid var(--ink);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: var(--ink);
    line-height: 1.12;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .ic {
    flex: none;
    color: var(--wine);
    font-size: 22px;
    transition: transform 0.2s;
    line-height: 1;
  }
  .faq details[open] summary .ic {
    transform: rotate(45deg);
  }
  .faq summary:hover {
    color: var(--wine);
  }
  .faq details p {
    margin: 0 0 22px;
    font-size: 16px;
    color: var(--text);
    max-width: 78ch;
  }

  @media (max-width: 900px) {
    .detail {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .aside {
      position: static;
    }
    .more-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
