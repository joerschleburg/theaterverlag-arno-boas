---
import { path } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StickyKatalog from "../../components/StickyKatalog.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import {
  AUTOREN,
  autorPhotoAlt,
  autorPhotoSrc,
} from "../../lib/autoren";
import { SITE } from "../../lib/site";

const manuscriptMail = `mailto:${SITE.email}?subject=${encodeURIComponent("Manuskript einsenden")}`;

const faqs = [
  {
    question: "Wie werde ich Autorin oder Autor beim Theaterverlag Arno Boas?",
    answer:
      "Senden Sie Ihr Theaterstück ausschließlich als PDF per E-Mail an info@theaterverlag-arno-boas.de (Betreff „Manuskript einsenden“). Wir prüfen jedes Manuskript. Eine Aufnahme ins Programm erfolgt nur, wenn wir uns bei Ihnen melden.",
  },
  {
    question: "Kann jede und jeder ein Manuskript einreichen?",
    answer:
      "Ja. Wir suchen laufend neue Autorinnen und Autoren — auch solche, die bisher nur für sich geschrieben haben. Gerade unbekannten Talenten geben wir gern eine Chance. Voraussetzung ist ein Theaterstück, das fürs Amateurtheater spielbar ist.",
  },
  {
    question: "Wie muss ein Manuskript aufgebaut sein?",
    answer:
      "Bitte nur als PDF, digital per E-Mail — andere Formate und Postsendungen können wir nicht berücksichtigen. Fügen Sie gerne eine kurze Inhaltsangabe und ein paar Zeilen zu Ihrer Person bei. Weitere formale Vorgaben (z. B. Schriftgröße) verlangen wir nicht.",
  },
  {
    question: "Wie lange dauert die Prüfung meines Manuskripts?",
    answer:
      "In der Regel bis zu acht Wochen. Von Nachfragen zum Bearbeitungsstand bitten wir abzusehen. Hören Sie in dieser Zeit nichts von uns, nehmen wir das Stück leider nicht in unser Programm auf.",
  },
  {
    question: "Wo finde ich die Stücke einer bestimmten Autorin oder eines Autors?",
    answer:
      "Auf der jeweiligen Autorenseite steht das Werkverzeichnis mit allen Titeln aus dem aktuellen Repertoire — verlinkt zur Stückseite.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title="Autorinnen und Autoren"
  description="Über 40 Autorinnen und Autoren schreiben für den Theaterverlag Arno Boas."
  jsonLd={faqLd}
>
  <SiteHeader active="/autoren" />

  <section class="wrap page">
    <span class="cap-label">Repertoire</span>
    <h1>Autorinnen und Autoren</h1>
    <p class="lead">
      Über 40 Autorinnen und Autoren schreiben für den Theaterverlag Arno Boas —
      vom Schwank bis zum Drama. Porträts ohne echtes Pressefoto sind vorerst
      Platzhalter.
    </p>

    <div class="grid">
      {
        AUTOREN.map((a) => (
          <a class="ac" href={path(`/autoren/${a.slug}`)}>
            <div class="ph">
              <img
                src={autorPhotoSrc(a)}
                alt={autorPhotoAlt(a)}
                width="600"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="nm">{a.name}</div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap submit-sec" id="manuskript">
    <div class="submit">
      <span class="cap-label">Sie schreiben selbst?</span>
      <h2>Aus der Schublade auf die Bühne.</h2>
      <p>
        Wir suchen laufend neue Autorinnen und Autoren — auch solche, die bisher
        nur für sich geschrieben haben. Gerade unbekannten Talenten geben wir
        gern eine Chance.
      </p>
      <ul class="rules">
        <li>
          Bitte senden Sie Ihr Theaterstück <b>ausschließlich als PDF</b> —
          digital per E-Mail. Andere Formate und Postsendungen können wir nicht
          berücksichtigen.
        </li>
        <li>
          Fügen Sie gerne eine kurze Inhaltsangabe und ein paar Zeilen zu Ihrer
          Person bei.
        </li>
        <li>
          Die Prüfung dauert in der Regel bis zu <b>acht Wochen</b>. Von
          Nachfragen zum Bearbeitungsstand bitten wir abzusehen.
        </li>
        <li>
          Hören Sie binnen acht Wochen nichts von uns, nehmen wir das Stück
          leider <b>nicht in unser Programm</b> auf.
        </li>
      </ul>
      <a href={manuscriptMail}>
        <i class="ti ti-send" aria-hidden="true" /> Manuskript als PDF senden
      </a>
      <p class="mail-hint">
        An {SITE.email} — Betreff „Manuskript einsenden“.
      </p>
    </div>
  </section>

  <NewsletterSignup />

  <section class="wrap faq-sec">
    <div class="faq-h">
      <span class="cap-label">Häufige Fragen</span>
      <h2>Manuskript &amp; Aufnahme</h2>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="ic">
                <i class="ti ti-plus" aria-hidden="true" />
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .page {
    padding-block: 56px 40px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 0.95;
    margin: 10px 0 16px;
  }
  .lead {
    color: var(--muted);
    max-width: 56ch;
    margin: 0 0 48px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px 22px;
  }
  .ac {
    text-decoration: none;
    color: var(--ink);
  }
  .ph {
    aspect-ratio: 3 / 4;
    background: var(--paper-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--hair);
    font-size: 42px;
    border-radius: 8px;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .ac:hover .ph {
    border-color: var(--ink);
    transform: translateY(-3px);
  }
  .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }
  .nm {
    margin-top: 12px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 18px;
  }
  .tbd {
    opacity: 0.55;
  }
  .tbd .nm {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--muted);
  }
  .submit-sec {
    padding-block: 8px 24px;
  }
  .submit {
    margin: 24px 0 0;
    background: var(--ink);
    color: #efe6d8;
    padding: 54px 40px;
    text-align: center;
    border-radius: 10px;
  }
  .submit :global(.cap-label) {
    color: var(--yellow);
  }
  .submit h2 {
    color: #fff;
    font-size: clamp(26px, 3.4vw, 40px);
    margin: 12px 0;
  }
  .submit p {
    color: #c6bcac;
    max-width: 60ch;
    margin: 0 auto 22px;
  }
  .submit .rules {
    list-style: none;
    margin: 0 auto 28px;
    padding: 0;
    max-width: 58ch;
    text-align: left;
    display: grid;
    gap: 12px;
  }
  .submit .rules li {
    position: relative;
    padding-left: 22px;
    color: #d5cbb9;
    font-size: 15px;
    line-height: 1.55;
  }
  .submit .rules li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .submit .rules b {
    color: #fff;
    font-weight: 700;
  }
  .submit a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--wine);
    color: #fff;
    padding: 14px 26px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 6px;
  }
  .submit a:hover {
    background: var(--wine-dark);
  }
  .submit .mail-hint {
    margin: 18px auto 0;
    font-size: 13.5px;
    color: #9e9484;
    max-width: 52ch;
  }
  .submit .mail-hint .inline {
    display: inline;
    background: none;
    color: var(--yellow);
    padding: 0;
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    text-underline-offset: 2px;
    border-radius: 0;
  }
  .submit .mail-hint .inline:hover {
    color: #fff;
    background: none;
  }
  .faq-sec {
    padding-block: 24px 48px;
  }
  .faq-h {
    margin-bottom: 22px;
  }
  .faq-h h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1;
    margin-top: 10px;
  }
  .faq {
    border-top: 2px solid var(--ink);
  }
  .faq details {
    border-bottom: 1px solid var(--border);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 23px);
    color: var(--ink);
    line-height: 1.12;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary .ic {
    flex: none;
    color: var(--wine);
    font-size: 22px;
    transition: transform 0.2s;
    line-height: 1;
  }
  .faq details[open] summary .ic {
    transform: rotate(45deg);
  }
  .faq summary:hover {
    color: var(--wine);
  }
  .faq details p {
    margin: 0 0 22px;
    font-size: 16px;
    color: var(--text);
    max-width: 78ch;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
