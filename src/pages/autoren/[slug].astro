---
import { path } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StickyKatalog from "../../components/StickyKatalog.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import {
  AUTOREN,
  autorPhotoAlt,
  autorPhotoSrc,
  getAutorBySlug,
} from "../../lib/autoren";

export function getStaticPaths() {
  return AUTOREN.map((a) => ({ params: { slug: a.slug } }));
}

const author = getAutorBySlug(Astro.params.slug!);
if (!author) {
  return Astro.redirect(path("/autoren"));
}
---

<BaseLayout
  title={author.name}
  description={`${author.name} — Theaterverlag Arno Boas.`}
>
  <SiteHeader active="/autoren" />

  <article class="wrap page">
    <a class="back" href={path("/autoren")}>← Alle Autorinnen und Autoren</a>
    <div class="hero-row">
      <div class="ph">
        <img
          src={autorPhotoSrc(author)}
          alt={autorPhotoAlt(author)}
          width="600"
          height="800"
        />
        {
          author.photoStock && (
            <span class="stock-note">Platzhalterfoto</span>
          )
        }
      </div>
      <div>
        <span class="cap-label">Autorin / Autor</span>
        <h1>{author.name}</h1>
        <p class="role">{author.role}</p>
        <p class="bio">
          {
            author.bio ||
              "Kurzbio und Werkverzeichnis folgen."
          }
        </p>
      </div>
    </div>
  </article>

  <NewsletterSignup />
  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .page {
    padding-block: 48px 90px;
  }
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 28px;
  }
  .back:hover {
    color: var(--wine);
  }
  .hero-row {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    align-items: start;
  }
  .ph {
    position: relative;
    aspect-ratio: 3 / 4;
    background: var(--paper-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 44px rgba(20, 12, 6, 0.18);
  }
  .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
  }
  .stock-note {
    position: absolute;
    left: 10px;
    bottom: 10px;
    background: rgba(26, 22, 17, 0.72);
    color: #f5efe4;
    font-size: 10px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 5px 8px;
    border-radius: 4px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 58px);
    line-height: 0.95;
    margin: 10px 0 12px;
  }
  .role {
    color: var(--wine);
    font-weight: 600;
    margin: 0 0 18px;
  }
  .bio {
    color: var(--muted);
    max-width: 52ch;
    margin: 0;
  }
  @media (max-width: 720px) {
    .hero-row {
      grid-template-columns: 1fr;
    }
    .ph {
      max-width: 260px;
    }
  }
</style>
