---
import { path } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StickyKatalog from "../../components/StickyKatalog.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import {
  AUTOREN,
  autorPhotoAlt,
  autorPhotoSrc,
  getAutorBySlug,
} from "../../lib/autoren";
import { getStuecke, stueckHref } from "../../lib/stuecke";
import { genreFilterLabel } from "../../lib/site";

export function getStaticPaths() {
  return AUTOREN.map((a) => ({ params: { slug: a.slug } }));
}

const author = getAutorBySlug(Astro.params.slug!);
if (!author) {
  return Astro.redirect(path("/autoren"));
}

const works = getStuecke()
  .filter((s) => (s.autor || "").trim() === author.name)
  .sort((a, b) => a.titel.localeCompare(b.titel, "de"));
---

<BaseLayout
  title={author.name}
  description={`${author.name} — Autorin/Autor beim Theaterverlag Arno Boas.`}
>
  <SiteHeader active="/autoren" />

  <article class="wrap page">
    <a class="back" href={path("/autoren")}>← Alle Autorinnen und Autoren</a>
    <div class="hero-row">
      <div class="ph">
        <img
          src={autorPhotoSrc(author)}
          alt={autorPhotoAlt(author)}
          width="600"
          height="800"
        />
        {
          author.photoStock && (
            <span class="stock-note">Platzhalterfoto</span>
          )
        }
      </div>
      <div>
        <span class="cap-label">Autorin / Autor</span>
        <h1>{author.name}</h1>
        <p class="role">{author.role}</p>
        <p class="bio">
          {
            author.bio ||
              (works.length
                ? `${works.length} ${works.length === 1 ? "Stück" : "Stücke"} im Repertoire des Theaterverlags Arno Boas.`
                : "Kurzbio folgt.")
          }
        </p>
      </div>
    </div>

    {
      works.length > 0 && (
        <section class="works">
          <h2>Werkverzeichnis</h2>
          <ul>
            {works.map((s) => (
              <li>
                <a href={stueckHref(s.slug)}>
                  <span class="wt">{s.titel}</span>
                  <span class="wm">
                    {genreFilterLabel(s.kategorien[0] || "")}
                    {s.spielart_geschaetzt ? ` · ${s.spielart_geschaetzt}` : ""}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <NewsletterSignup />
  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<style>
  .page {
    padding-block: 48px 90px;
  }
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 28px;
  }
  .back:hover {
    color: var(--wine);
  }
  .hero-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 40px;
    align-items: start;
  }
  .ph {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--paper-2);
  }
  .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .stock-note {
    position: absolute;
    left: 10px;
    bottom: 10px;
    background: rgba(26, 22, 17, 0.72);
    color: #f2e9d8;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 8px;
  }
  h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    margin: 10px 0 8px;
    line-height: 1.05;
  }
  .role {
    color: var(--wine);
    font-weight: 600;
    margin: 0 0 14px;
  }
  .bio {
    color: var(--muted);
    font-size: 17px;
    max-width: 52ch;
    margin: 0;
  }
  .works {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .works h2 {
    font-size: clamp(24px, 3vw, 34px);
    margin: 0 0 18px;
  }
  .works ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .works li {
    border-bottom: 1px solid var(--border);
  }
  .works a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 0;
    text-decoration: none;
    color: inherit;
  }
  .works a:hover .wt {
    color: var(--wine);
  }
  .wt {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(18px, 2vw, 22px);
  }
  .wm {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .hero-row {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .ph {
      max-width: 260px;
    }
    .works a {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>
