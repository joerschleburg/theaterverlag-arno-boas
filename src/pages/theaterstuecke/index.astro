---
import { path } from "../../lib/paths";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import StickyKatalog from "../../components/StickyKatalog.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { getStuecke, overviewHref, stueckHref } from "../../lib/stuecke";
import { GENRE_FILTER_OPTIONS, genreFilterLabel } from "../../lib/site";

const stuecke = getStuecke();
const PAGE_SIZE = 24;
const overviewBase = path("/theaterstuecke");

const hasCastData = stuecke.some(
  (s) => typeof s.besetzung_m === "number" || typeof s.besetzung_w === "number",
);
const hasVenueData = stuecke.some((s) => Boolean(s.spielort));

const faqs = [
  {
    question: "Welche Theaterstücke gibt es für Amateurtheater?",
    answer:
      "Über 250 Bühnenstücke von rund 40 Autorinnen und Autoren: Komödie, Krimi, Krimikomödie, Märchen, Drama, Weihnachten, Tragikomödie, Kinder & Jugend und Für Senioren.",
  },
  {
    question: "Gibt es Stücke für kleine Ensembles?",
    answer:
      "Ja. Das Repertoire reicht von kleinen Besetzungen bis zu größeren Ensembles. Auf den Stückseiten und in der Übersicht finden Sie die Angaben zu Herren- und Damenrollen.",
  },
  {
    question: "Welche Genres bietet der Theaterverlag Arno Boas?",
    answer:
      "Komödie, Krimi, Krimikomödie, Märchen, Drama, Weihnachten, Tragikomödie, Kinder & Jugend und Für Senioren.",
  },
  {
    question: "Kann ich vor der Entscheidung eine Leseprobe bekommen?",
    answer:
      "Ja. Zu den abendfüllenden Stücken gibt es eine kostenlose Leseprobe als PDF mit rund der Hälfte des Stücks. Das komplette Ansichtsexemplar können Sie vier Wochen unverbindlich anfordern.",
  },
  {
    question: "Dürfen wir die Stücke im Dialekt spielen?",
    answer:
      "Ja. Die Stücke sind in verständlicher Umgangssprache verfasst und lassen sich leicht in jeden Dialekt übertragen oder auf Hochdeutsch spielen.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

const genres = GENRE_FILTER_OPTIONS;
---

<BaseLayout
  title="Alle Theaterstücke"
  description="Über 250 Bühnenstücke durchsuchen und filtern — Theaterverlag Arno Boas."
  jsonLd={faqLd}
>
  <SiteHeader active="/theaterstuecke" />

  <section class="intro">
    <div class="wrap">
      <span class="cap-label">Repertoire</span>
      <h1>Alle Theaterstücke</h1>
      <p>
        Über 250 Bühnenstücke fürs Amateurtheater — suchen und filtern Sie nach
        Genre, Ensemblegröße, Spielort und Dauer.
      </p>
    </div>
  </section>

  <div class="filterbar" data-overview-filters data-base={overviewBase} data-page-size={PAGE_SIZE} data-has-cast={hasCastData ? "1" : "0"} data-has-venue={hasVenueData ? "1" : "0"}>
    <div class="wrap">
      <form class="fb" method="get" action={overviewBase} id="filter-form">
        <div class="f wide">
          <label for="q">Suche</label>
          <input
            id="q"
            name="q"
            type="search"
            placeholder="Stück, Autor, Stichwort …"
            autocomplete="off"
          />
        </div>
        <div class="f">
          <label for="genre">Genre</label>
          <select id="genre" name="genre">
            {genres.map((opt) => <option value={opt}>{opt}</option>)}
          </select>
        </div>
        <div class="f sm">
          <label for="herren">Herrenrollen</label>
          <select id="herren" name="herren" disabled={!hasCastData} title={!hasCastData ? "Besetzungsdaten folgen noch" : undefined}>
            {
              ["beliebig", "1", "2", "3", "4", "5", "6", "7+"].map((opt) => (
                <option value={opt}>{opt === "7+" ? "7 und mehr" : opt}</option>
              ))
            }
          </select>
        </div>
        <div class="f sm">
          <label for="damen">Damenrollen</label>
          <select id="damen" name="damen" disabled={!hasCastData} title={!hasCastData ? "Besetzungsdaten folgen noch" : undefined}>
            {
              ["beliebig", "1", "2", "3", "4", "5", "6", "7+"].map((opt) => (
                <option value={opt}>{opt === "7+" ? "7 und mehr" : opt}</option>
              ))
            }
          </select>
        </div>
        <div class="f">
          <label for="spielort">Spielort</label>
          <select id="spielort" name="spielort" disabled={!hasVenueData} title={!hasVenueData ? "Spielort-Angaben folgen noch" : undefined}>
            {
              ["egal", "Saal", "Freilicht", "beides"].map((opt) => (
                <option value={opt}>{opt}</option>
              ))
            }
          </select>
        </div>
        <div class="f">
          <label for="dauer">Dauer</label>
          <select id="dauer" name="dauer">
            {
              ["alle", "Abendfüllend", "Einakter", "Kurzstück"].map((opt) => (
                <option value={opt}>{opt}</option>
              ))
            }
          </select>
        </div>
        <input type="hidden" name="ensemble" id="ensemble" value="beliebig" />
        <button class="go" type="submit">
          <i class="ti ti-search" aria-hidden="true"></i> Suchen
        </button>
      </form>

      <div class="fb2">
        <div class="chips" id="filter-chips"></div>
        <div class="result-meta" id="result-meta" hidden>
          <span aria-live="polite">
            <b id="result-count">0</b>
            <span id="result-label">Treffer</span>
          </span>
        </div>
      </div>
      {
        (!hasCastData || !hasVenueData) && (
          <p class="filter-note" id="filter-note">
            {!hasCastData && "Herren-/Damenrollen folgen mit den Besetzungsdaten. "}
            {!hasVenueData && "Spielort-Filter folgt mit den Stammdaten."}
          </p>
        )
      }
    </div>
  </div>

  <section class="results">
    <div class="wrap">
      <div class="list" id="stueck-list">
        {
          stuecke.map((s) => (
            <article
              class="li"
              data-slug={s.slug}
              data-titel={s.titel}
              data-untertitel={s.untertitel}
              data-kuerzel={s.kuerzel}
              data-kategorien={s.kategorien.join("|")}
              data-dauer={s.spielart_geschaetzt}
              data-m={typeof s.besetzung_m === "number" ? String(s.besetzung_m) : ""}
              data-w={typeof s.besetzung_w === "number" ? String(s.besetzung_w) : ""}
              data-ort={s.spielort || ""}
              hidden
            >
              <div class="lt">
                <span class="g">{s.untertitel || genreFilterLabel(s.kategorien[0] || "")}</span>
                <span>{s.spielart_geschaetzt}</span>
              </div>
              <a class="lh" href={stueckHref(s.slug)}>{s.titel}</a>
              <div class="ls">{s.untertitel}</div>
              <div class="lb">
                <span class="lm">
                  {typeof s.besetzung_m === "number" || typeof s.besetzung_w === "number"
                    ? `${s.besetzung_m ?? "–"} Herren · ${s.besetzung_w ?? "–"} Damen`
                    : s.kategorien.map(genreFilterLabel).join(" · ")}
                  {s.kuerzel ? ` · ${s.kuerzel}` : ""}
                  {typeof s.spieldauer_min === "number" ? ` · ca. ${s.spieldauer_min} Min.` : ""}
                </span>
                <span class="la">
                  <button
                    type="button"
                    class="mk"
                    data-bookmark={s.slug}
                    aria-label={`${s.titel} merken`}
                  >
                    <i class="ti ti-bookmark" aria-hidden="true" />
                    <span class="tip">Merken</span>
                  </button>
                  <a class="zu" href={stueckHref(s.slug)}>
                    Zum Stück <i class="ti ti-arrow-right" aria-hidden="true" />
                  </a>
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <p class="empty" id="empty-state" hidden>
        Keine Treffer. <a href={overviewHref()}>Filter zurücksetzen</a>
      </p>

      <div class="loadmore" id="load-more-wrap" hidden>
        <button type="button" id="load-more">Weitere Stücke laden</button>
      </div>
    </div>
  </section>

  <NewsletterSignup />

  <section class="wrap faq-sec">
    <div class="faq-h">
      <span class="cap-label">Häufige Fragen</span>
      <h2>Gut zu wissen</h2>
    </div>
    <div class="faq">
      {
        faqs.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="ic">
                <i class="ti ti-plus" aria-hidden="true" />
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<script>
  type Params = {
    q: string;
    genre: string;
    dauer: string;
    herren: string;
    damen: string;
    spielort: string;
    ensemble: string;
    sort: string;
  };

  const root = document.querySelector<HTMLElement>("[data-overview-filters]");
  const form = document.getElementById("filter-form") as HTMLFormElement | null;
  const list = document.getElementById("stueck-list");
  const chipsEl = document.getElementById("filter-chips");
  const countEl = document.getElementById("result-count");
  const countLabelEl = document.getElementById("result-label");
  const metaEl = document.getElementById("result-meta");
  const emptyEl = document.getElementById("empty-state");
  const loadWrap = document.getElementById("load-more-wrap");
  const loadBtn = document.getElementById("load-more");

  if (!root || !form || !list) {
    // no-op
  } else {
    const base = root.dataset.base || "/theaterstuecke";
    const pageSize = Number(root.dataset.pageSize || 24);
    const hasCast = root.dataset.hasCast === "1";
    const hasVenue = root.dataset.hasVenue === "1";
    const items = Array.from(list.querySelectorAll<HTMLElement>(".li"));
    let visibleSlugs: string[] = [];
    let shown = 0;

    function readParams(): Params {
      const sp = new URLSearchParams(location.search);
      return {
        q: (sp.get("q") || "").trim(),
        genre: normalizeGenreParam(sp.get("genre") || "alle"),
        dauer: sp.get("dauer") || "alle",
        herren: sp.get("herren") || "beliebig",
        damen: sp.get("damen") || "beliebig",
        spielort: sp.get("spielort") || "egal",
        ensemble: sp.get("ensemble") || "beliebig",
        sort: "az",
      };
    }

    /** Keine Katalog-Gesamtzahl zeigen — nur Treffer bei aktiver Suche/Filter. */
    function isFiltered(p: Params) {
      return Boolean(
        p.q ||
          (p.genre && p.genre !== "alle") ||
          (p.dauer && p.dauer !== "alle") ||
          (hasCast && p.herren && p.herren !== "beliebig") ||
          (hasCast && p.damen && p.damen !== "beliebig") ||
          (hasVenue && p.spielort && p.spielort !== "egal") ||
          (p.ensemble && p.ensemble !== "beliebig"),
      );
    }

    function updateResultMeta(p: Params, matchedCount: number) {
      if (!metaEl || !countEl) return;
      if (!isFiltered(p)) {
        metaEl.hidden = true;
        return;
      }
      metaEl.hidden = false;
      countEl.textContent = String(matchedCount);
      if (countLabelEl) {
        countLabelEl.textContent = "Treffer";
      }
    }

    function normalizeGenreParam(genre: string) {
      return genre === "Für Jugendliche" ? "Kinder & Jugend" : genre;
    }

    function syncForm(p: Params) {
      const set = (name: string, value: string) => {
        const el = form!.elements.namedItem(name) as
          | HTMLInputElement
          | HTMLSelectElement
          | null;
        if (el) el.value = value;
      };
      set("q", p.q);
      set("genre", p.genre);
      set("dauer", p.dauer);
      set("herren", hasCast ? p.herren : "beliebig");
      set("damen", hasCast ? p.damen : "beliebig");
      set("spielort", hasVenue ? p.spielort : "egal");
      set("ensemble", p.ensemble);
    }

    function dauerOk(piece: string, filter: string) {
      if (!filter || filter === "alle") return true;
      if (filter === "Kurzstück") return piece === "Sketch" || piece === "Kurzstück";
      if (filter === "Sketch") return piece === "Sketch" || piece === "Kurzstück";
      return piece === filter;
    }

    function genreOk(kats: string[], genre: string) {
      if (!genre || genre === "alle") return true;
      // Alte URLs mit „Für Jugendliche“ weiterhin unterstützen
      if (genre === "Kinder & Jugend" || genre === "Für Jugendliche") {
        return kats.includes("Für Jugendliche");
      }
      return kats.includes(genre);
    }

    function castOk(value: string, filter: string) {
      if (!filter || filter === "beliebig") return true;
      if (value === "") return false;
      const n = Number(value);
      if (filter === "7+") return n >= 7;
      return n === Number(filter);
    }

    function ensembleOk(kats: string[], m: string, w: string, ensemble: string) {
      if (!ensemble || ensemble === "beliebig") return true;
      if (ensemble === "kinder-jugend") return kats.includes("Für Jugendliche");
      // Größenfilter brauchen Besetzungszahlen — ohne Stammdaten nicht anwenden
      if (!hasCast) return true;
      if (m === "" && w === "") return false;
      const total = (m === "" ? 0 : Number(m)) + (w === "" ? 0 : Number(w));
      if (ensemble === "bis-6") return total > 0 && total <= 6;
      if (ensemble === "7-10") return total >= 7 && total <= 10;
      if (ensemble === "ueber-10") return total > 10;
      return true;
    }

    function matches(el: HTMLElement, p: Params) {
      const titel = el.dataset.titel || "";
      const untertitel = el.dataset.untertitel || "";
      const kuerzel = el.dataset.kuerzel || "";
      const kats = (el.dataset.kategorien || "").split("|").filter(Boolean);
      const dauer = el.dataset.dauer || "";
      const m = el.dataset.m || "";
      const w = el.dataset.w || "";
      const ort = el.dataset.ort || "";

      if (p.q) {
        const needle = p.q.toLowerCase();
        const hay = [titel, untertitel, kuerzel, ...kats].join(" ").toLowerCase();
        if (!hay.includes(needle)) return false;
      }
      if (!genreOk(kats, p.genre)) return false;
      if (!dauerOk(dauer, p.dauer)) return false;
      if (hasCast) {
        if (!castOk(m, p.herren)) return false;
        if (!castOk(w, p.damen)) return false;
      }
      if (hasVenue && p.spielort !== "egal") {
        const ortNorm = ort.toLowerCase();
        if (p.spielort === "beides") {
          if (ortNorm !== "beides") return false;
        } else if (p.spielort === "Saal") {
          if (ortNorm !== "saal" && ortNorm !== "beides") return false;
        } else if (p.spielort === "Freilicht") {
          if (ortNorm !== "freilicht" && ortNorm !== "beides") return false;
        } else if (ortNorm !== p.spielort.toLowerCase()) {
          return false;
        }
      }
      if (!ensembleOk(kats, m, w, p.ensemble)) return false;
      return true;
    }

    function sortItems(arr: HTMLElement[]) {
      return [...arr].sort((a, b) =>
        (a.dataset.titel || "").localeCompare(b.dataset.titel || "", "de"),
      );
    }

    function hrefWithout(p: Params, keys: string[]) {
      const next: Record<string, string> = { ...p };
      for (const k of keys) {
        if (k === "q") next.q = "";
        else if (k === "genre") next.genre = "alle";
        else if (k === "dauer") next.dauer = "alle";
        else if (k === "herren") next.herren = "beliebig";
        else if (k === "damen") next.damen = "beliebig";
        else if (k === "spielort") next.spielort = "egal";
        else if (k === "ensemble") next.ensemble = "beliebig";
      }
      return buildUrl(next);
    }

    function buildUrl(p: Params) {
      const q = new URLSearchParams();
      if (p.q) q.set("q", p.q);
      if (p.genre && p.genre !== "alle") q.set("genre", p.genre);
      if (p.dauer && p.dauer !== "alle") q.set("dauer", p.dauer);
      if (hasCast && p.herren && p.herren !== "beliebig") q.set("herren", p.herren);
      if (hasCast && p.damen && p.damen !== "beliebig") q.set("damen", p.damen);
      if (hasVenue && p.spielort && p.spielort !== "egal") q.set("spielort", p.spielort);
      if (p.ensemble && p.ensemble !== "beliebig") q.set("ensemble", p.ensemble);
      const s = q.toString();
      return s ? `${base}?${s}` : base;
    }

    function renderChips(p: Params) {
      if (!chipsEl) return;
      const chips: { label: string; href: string }[] = [];
      if (p.q) chips.push({ label: `„${p.q}"`, href: hrefWithout(p, ["q"]) });
      if (p.genre !== "alle") chips.push({ label: p.genre, href: hrefWithout(p, ["genre"]) });
      if (p.dauer !== "alle") chips.push({ label: p.dauer, href: hrefWithout(p, ["dauer"]) });
      if (hasCast && p.herren !== "beliebig") {
        chips.push({
          label: p.herren === "7+" ? "ab 7 Herren" : `${p.herren} Herren`,
          href: hrefWithout(p, ["herren"]),
        });
      }
      if (hasCast && p.damen !== "beliebig") {
        chips.push({
          label: p.damen === "7+" ? "ab 7 Damen" : `${p.damen} Damen`,
          href: hrefWithout(p, ["damen"]),
        });
      }
      if (hasVenue && p.spielort !== "egal") {
        chips.push({ label: p.spielort, href: hrefWithout(p, ["spielort"]) });
      }
      if (p.ensemble === "kinder-jugend") {
        chips.push({ label: "Kinder & Jugend", href: hrefWithout(p, ["ensemble"]) });
      } else if (p.ensemble !== "beliebig") {
        chips.push({ label: `Ensemble ${p.ensemble}`, href: hrefWithout(p, ["ensemble"]) });
      }

      if (!chips.length) {
        chipsEl.innerHTML = "";
        return;
      }
      chipsEl.innerHTML =
        `<span class="lbl">Aktive Filter:</span>` +
        chips
          .map(
            (c) =>
              `<a class="chip" href="${c.href}">${c.label} <i class="ti ti-x" aria-hidden="true"></i></a>`,
          )
          .join("") +
        `<a class="chip clear" href="${base}">alle zurücksetzen</a>`;
    }

    function paint() {
      items.forEach((el) => {
        el.hidden = true;
        el.classList.add("is-more");
      });
      const order = new Map(visibleSlugs.map((s, i) => [s, i]));
      const matched = items
        .filter((el) => order.has(el.dataset.slug || ""))
        .sort(
          (a, b) =>
            (order.get(a.dataset.slug || "") || 0) -
            (order.get(b.dataset.slug || "") || 0),
        );

      // Keep DOM order aligned with sort for load-more slicing
      matched.forEach((el) => list!.appendChild(el));

      shown = 0;
      const reveal = () => {
        const next = matched.slice(shown, shown + pageSize);
        next.forEach((el) => {
          el.hidden = false;
          el.classList.remove("is-more");
        });
        shown += next.length;
        if (loadWrap) loadWrap.hidden = shown >= matched.length;
      };
      reveal();

      if (emptyEl) emptyEl.hidden = matched.length > 0;
      if (loadBtn) {
        loadBtn.onclick = () => reveal();
      }
    }

    function apply(push: boolean) {
      const p = readParams();
      syncForm(p);
      renderChips(p);
      const matched = sortItems(items.filter((el) => matches(el, p)));
      visibleSlugs = matched.map((el) => el.dataset.slug || "");
      paint();
      updateResultMeta(p, matched.length);
      if (push) {
        const url = buildUrl(p);
        history.replaceState(null, "", url);
      }
    }

    function applyFromForm(pushState: boolean) {
      const fd = new FormData(form!);
      const p: Params = {
        q: String(fd.get("q") || "").trim(),
        genre: String(fd.get("genre") || "alle"),
        dauer: String(fd.get("dauer") || "alle"),
        herren: String(fd.get("herren") || "beliebig"),
        damen: String(fd.get("damen") || "beliebig"),
        spielort: String(fd.get("spielort") || "egal"),
        ensemble: String(fd.get("ensemble") || "beliebig"),
        sort: "az",
      };
      const url = buildUrl(p);
      if (pushState) history.pushState(null, "", url);
      else history.replaceState(null, "", url);
      syncForm(p);
      renderChips(p);
      const matched = sortItems(items.filter((el) => matches(el, p)));
      visibleSlugs = matched.map((el) => el.dataset.slug || "");
      paint();
      updateResultMeta(p, matched.length);
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      applyFromForm(true);
    });

    // Sofort filtern bei Dropdown-Änderung
    form.querySelectorAll("select").forEach((el) => {
      el.addEventListener("change", () => applyFromForm(true));
    });

    // Sofort filtern bei Tippen (kurz entprellt)
    let qTimer = 0;
    const qInput = form.querySelector<HTMLInputElement>("#q");
    qInput?.addEventListener("input", () => {
      window.clearTimeout(qTimer);
      qTimer = window.setTimeout(() => applyFromForm(true), 180);
    });

    chipsEl?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest("a");
      if (!a || !chipsEl.contains(a)) return;
      e.preventDefault();
      history.pushState(null, "", a.getAttribute("href") || base);
      apply(false);
    });

    window.addEventListener("popstate", () => apply(false));

    // Initial paint from URL (homepage search + deep links)
    apply(false);
  }
</script>

<style>
  .intro {
    background: var(--wine);
    padding: 44px 0 40px;
  }
  .intro :global(.cap-label) {
    color: #fff;
    opacity: 0.82;
  }
  .intro h1 {
    color: #fff;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 0.96;
    margin: 12px 0 0;
  }
  .intro p {
    color: rgba(255, 255, 255, 0.9);
    margin: 14px 0 0;
    max-width: 60ch;
    font-size: 17px;
  }

  .filterbar {
    position: sticky;
    top: 74px;
    z-index: 30;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow:
      0 4px 0 rgba(20, 12, 6, 0.04),
      0 16px 40px rgba(20, 12, 6, 0.18);
  }
  .fb {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-wrap: nowrap;
  }
  .fb .f {
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    flex: 1;
    min-width: 138px;
    transition: background 0.15s;
