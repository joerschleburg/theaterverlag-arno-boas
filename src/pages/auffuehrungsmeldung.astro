---
import { path } from "../lib/paths";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyKatalog from "../components/StickyKatalog.astro";
import { SITE } from "../lib/site";

const web3Key = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
const pdfHref = path("/formulare/auffuehrungsmeldung.pdf");
const formulareHref = path("/formulare");
---

<BaseLayout
  title="Aufführungsmeldung"
  description="Aufführungen online melden — Theaterverlag Arno Boas."
>
  <SiteHeader />

  <section class="intro">
    <div class="wrap narrow">
      <span class="cap-label">Formulare</span>
      <h1>Aufführungsmeldung</h1>
      <p class="lead">
        Melden Sie geplante und stattgefundene Vorstellungen. Bei Plänen bitte
        die Einnahmen leer lassen — keine Prognosen eintragen.
      </p>
      <p class="alt">
        Lieber ausdrucken?
        <a href={pdfHref} download>PDF-Formular herunterladen</a>
        ·
        <a href={formulareHref}>Alle Formulare</a>
      </p>
    </div>
  </section>

  <section class="wrap narrow">
    <form
      class="form"
      id="aform"
      data-web3-key={web3Key}
      data-to={SITE.email}
    >
      <h2>Stück / Auftrag</h2>
      <div class="fld">
        <label for="a_titel">Titel des Stücks <span class="req">*</span></label>
        <input id="a_titel" name="titel" type="text" required />
      </div>
      <div class="two">
        <div class="fld">
          <label for="a_autor">Autor/in</label>
          <input id="a_autor" name="autor" type="text" />
        </div>
        <div class="fld">
          <label for="a_kuerzel">Kürzel / Bestell-Nr.</label>
          <input
            id="a_kuerzel"
            name="kuerzel"
            type="text"
            placeholder="falls bekannt"
          />
        </div>
      </div>

      <h2>Verantwortliche Person</h2>
      <div class="two">
        <div class="fld">
          <label for="a_name">Name <span class="req">*</span></label>
          <input id="a_name" name="name" type="text" required />
        </div>
        <div class="fld">
          <label for="a_gruppe">Theatergruppe / Verein</label>
          <input id="a_gruppe" name="gruppe" type="text" />
        </div>
      </div>
      <div class="fld">
        <label for="a_anschrift">Anschrift <span class="req">*</span></label>
        <input id="a_anschrift" name="anschrift" type="text" required />
      </div>
      <div class="two">
        <div class="fld">
          <label for="a_plzort">PLZ / Ort <span class="req">*</span></label>
          <input id="a_plzort" name="plzort" type="text" required />
        </div>
        <div class="fld">
          <label for="a_tel">Telefon</label>
          <input id="a_tel" name="telefon" type="tel" />
        </div>
      </div>
      <div class="fld">
        <label for="a_mail">E-Mail <span class="req">*</span></label>
        <input id="a_mail" name="email" type="email" required />
      </div>

      <h2>Aufstellung der Aufführungen</h2>
      <p class="hint">
        Bitte alle Vorstellungen angeben — auch die Premiere. Bei geplanten
        Terminen Gesamteinnahmen leer lassen.
      </p>
      <div class="table-wrap">
        <table class="perf" id="perf-table">
          <thead>
            <tr>
              <th>Datum</th>
              <th>Uhrzeit</th>
              <th>PLZ / Ort</th>
              <th>Platzzahl</th>
              <th>Gesamteinnahmen</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="perf-body"></tbody>
        </table>
      </div>
      <button class="add" type="button" id="add-perf">
        <i class="ti ti-plus" aria-hidden="true" /> Weitere Aufführung
      </button>

      <label class="chkrow" id="a_chkrow">
        <input id="a_ok" type="checkbox" required />
        <span
          >Wir versichern, dass außer diesen Aufführungen bisher keine weiteren
          stattgefunden haben, auch keine Proben oder Generalproben vor
          Zuschauern. Für eventuelle weitere Aufführungen holen wir rechtzeitig
          die erforderliche Genehmigung ein. Uns ist bekannt, dass unerlaubte
          Aufführungen gegen das Urheberrechtsgesetz verstoßen. Als
          „Gesamteinnahmen“ haben wir alle Einnahmen aus Eintrittsgeldern,
          Programmverkäufen, Sammlungen, Spenden usw. ohne Abzug eingetragen.
          <span class="req">*</span></span
        >
      </label>

      <label class="chkrow" id="a_dsgvo_row">
        <input id="a_dsgvo" type="checkbox" required />
        <span
          >Die <a href={path("/datenschutz")}>Datenschutzerklärung</a> habe ich
          gelesen und akzeptiert. <span class="req">*</span></span
        >
      </label>

      <button class="send" type="submit">
        <i class="ti ti-send" aria-hidden="true" /> Meldung absenden
      </button>
    </form>
  </section>

  <SiteFooter />
  <StickyKatalog />
</BaseLayout>

<script>
  const form = document.getElementById("aform") as HTMLFormElement | null;
  const body = document.getElementById("perf-body");
  const addBtn = document.getElementById("add-perf");

  function rowHtml() {
    return `<tr>
      <td><input type="date" name="datum[]" required /></td>
      <td><input type="time" name="uhrzeit[]" /></td>
      <td><input type="text" name="spielort[]" placeholder="PLZ Ort" required /></td>
      <td><input type="text" name="platzzahl[]" inputmode="numeric" /></td>
      <td><input type="text" name="einnahmen[]" placeholder="€ oder leer" /></td>
      <td><button type="button" class="rm-row" aria-label="Zeile entfernen"><i class="ti ti-x"></i></button></td>
    </tr>`;
  }

  function addRow() {
    if (!body) return;
    body.insertAdjacentHTML("beforeend", rowHtml());
  }

  if (body && addBtn) {
    addRow();
    addRow();
    addBtn.addEventListener("click", () => addRow());
    body.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".rm-row");
      if (!btn) return;
      const tr = btn.closest("tr");
      if (body.querySelectorAll("tr").length <= 1) return;
      tr?.remove();
    });
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const titel = document.getElementById("a_titel") as HTMLInputElement;
      const name = document.getElementById("a_name") as HTMLInputElement;
      const anschrift = document.getElementById(
        "a_anschrift",
      ) as HTMLInputElement;
      const plzort = document.getElementById("a_plzort") as HTMLInputElement;
      const mail = document.getElementById("a_mail") as HTMLInputElement;
      const ok = document.getElementById("a_ok") as HTMLInputElement;
      const dsgvo = document.getElementById("a_dsgvo") as HTMLInputElement;
      const chkrow = document.getElementById("a_chkrow");
      const dsgvoRow = document.getElementById("a_dsgvo_row");

      let bad = false;
      [titel, name, anschrift, plzort, mail].forEach((el) => {
        if (!el.value.trim()) {
          el.classList.add("err");
          bad = true;
        } else el.classList.remove("err");
      });
      if (
        mail.value.trim() &&
        !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail.value.trim())
      ) {
        mail.classList.add("err");
        bad = true;
      }
      if (!ok.checked) {
        chkrow?.classList.add("err");
        bad = true;
      } else chkrow?.classList.remove("err");
      if (!dsgvo.checked) {
        dsgvoRow?.classList.add("err");
        bad = true;
      } else dsgvoRow?.classList.remove("err");

      const rows = [...(body?.querySelectorAll("tr") || [])];
      const perfs = rows.map((tr, i) => {
        const inputs = tr.querySelectorAll("input");
        return {
          n: i + 1,
          datum: (inputs[0] as HTMLInputElement).value,
          uhrzeit: (inputs[1] as HTMLInputElement).value,
          ort: (inputs[2] as HTMLInputElement).value,
          platz: (inputs[3] as HTMLInputElement).value,
          einnahmen: (inputs[4] as HTMLInputElement).value,
        };
      });
      if (!perfs.length || perfs.some((p) => !p.datum || !p.ort)) {
        bad = true;
      }
      if (bad) return;

      const autor = (document.getElementById("a_autor") as HTMLInputElement)
        .value;
      const kuerzel = (
        document.getElementById("a_kuerzel") as HTMLInputElement
      ).value;
      const gruppe = (document.getElementById("a_gruppe") as HTMLInputElement)
        .value;
      const tel = (document.getElementById("a_tel") as HTMLInputElement).value;

      const perfLines = perfs
        .map(
          (p) =>
            `${p.n}. ${p.datum}${p.uhrzeit ? ` ${p.uhrzeit}` : ""} · ${p.ort}` +
            `${p.platz ? ` · Plätze: ${p.platz}` : ""}` +
            `${p.einnahmen ? ` · Einnahmen: ${p.einnahmen}` : " · Einnahmen: —"}`,
        )
        .join("\n");

      const key = form.dataset.web3Key || "";
      const payload = {
        access_key: key,
        subject: `Aufführungsmeldung — ${titel.value}`,
        from_name: name.value,
        email: mail.value,
        replyto: mail.value,
        to: form.dataset.to,
        message: [
          "Aufführungsmeldung über die Website",
          "",
          `Titel: ${titel.value}`,
          `Autor/in: ${autor || "—"}`,
          `Kürzel / Bestell-Nr.: ${kuerzel || "—"}`,
          "",
          `Name: ${name.value}`,
          `Theatergruppe / Verein: ${gruppe || "—"}`,
          `Anschrift: ${anschrift.value}`,
          `PLZ / Ort: ${plzort.value}`,
          `Telefon: ${tel || "—"}`,
          `E-Mail: ${mail.value}`,
          "",
          "Aufführungen:",
          perfLines,
        ].join("\n"),
      };

      if (key) {
        try {
          const res = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!data.success) throw new Error(data.message || "Fehler");
        } catch {
          alert(
            "Senden fehlgeschlagen. Bitte versuchen Sie es später erneut oder nutzen Sie das PDF-Formular.",
          );
          return;
        }
      }

      form.outerHTML =
        '<div class="thanks"><h2>Vielen Dank.</h2><p>Ihre Aufführungsmeldung wurde übermittelt. Wir melden uns bei Rückfragen.</p></div>';
    });
  }
</script>

<style>
  .narrow {
    max-width: 820px;
  }
  .intro {
    padding: 48px 0 8px;
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 10px 0 14px;
    line-height: 1.05;
  }
  .lead {
    font-size: 18px;
    color: var(--muted);
    max-width: 58ch;
    margin: 0 0 12px;
  }
  .alt {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .alt a {
    color: var(--wine);
    font-weight: 600;
  }
  .form {
    padding: 28px 0 90px;
  }
  .form h2 {
    font-size: clamp(22px, 2.6vw, 28px);
    margin: 32px 0 14px;
  }
  .form h2:first-child {
    margin-top: 0;
  }
  .hint {
    margin: 0 0 12px;
    font-size: 14px;
    color: var(--muted);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .fld {
    margin-bottom: 14px;
  }
  .fld label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .req {
    color: var(--wine);
  }
  .form input[type="text"],
  .form input[type="email"],
  .form input[type="tel"],
  .form input[type="date"],
  .form input[type="time"] {
    width: 100%;
    border: 1px solid var(--hair);
    background: #fff;
    border-radius: 8px;
    padding: 12px 14px;
    font: inherit;
    font-size: 15px;
  }
  .form input.err {
    border-color: #c0392b;
  }
  .table-wrap {
    overflow-x: auto;
    margin-bottom: 12px;
  }
  .perf {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .perf th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 8px 6px;
    border-bottom: 2px solid var(--ink);
  }
  .perf td {
    padding: 6px;
    vertical-align: middle;
    border-bottom: 1px solid var(--border);
  }
  .perf input {
    width: 100%;
    min-width: 88px;
    border: 1px solid var(--hair);
    border-radius: 6px;
    padding: 8px 10px;
    font: inherit;
    font-size: 13px;
    background: #fff;
  }
  .rm-row {
    border: none;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 18px;
    padding: 4px;
  }
  .add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px dashed var(--hair);
    background: transparent;
    color: var(--ink);
    border-radius: 8px;
    padding: 10px 14px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: 22px;
  }
  .add:hover {
    border-color: var(--wine);
    color: var(--wine);
  }
  .chkrow {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 16px;
    color: var(--text);
  }
  .chkrow input {
    margin-top: 3px;
    flex: none;
    accent-color: var(--wine);
  }
  .chkrow a {
    color: var(--wine);
  }
  .chkrow.err {
    color: #c0392b;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--wine);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 15px 24px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 8px;
  }
  .send:hover {
    background: var(--wine-dark);
  }
  :global(.thanks) {
    padding: 48px 0 90px;
  }
  :global(.thanks h2) {
    font-size: clamp(28px, 4vw, 40px);
    margin: 0 0 12px;
  }
  @media (max-width: 720px) {
    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
