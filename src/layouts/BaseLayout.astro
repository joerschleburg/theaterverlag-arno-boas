---
import "../styles/tokens.css";
import MerklisteApp from "../components/MerklisteApp.astro";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** dark mast over hero (home) vs sticky light header */
  headerVariant?: "hero" | "page";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.name,
  description = SITE.description,
  headerVariant = "page",
  jsonLd,
} = Astro.props;

const fullTitle =
  title === SITE.name ? title : `${title} — ${SITE.name}`;

const schemas = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.11.0/dist/tabler-icons.min.css"
    />
    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body data-header={headerVariant}>
    <slot />
    <MerklisteApp />
  </body>
</html>
